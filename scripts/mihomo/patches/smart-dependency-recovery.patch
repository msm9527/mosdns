diff --git a/adapter/outboundgroup/smart_dependencies.go b/adapter/outboundgroup/smart_dependencies.go
new file mode 100644
index 0000000..4476f60
--- /dev/null
+++ b/adapter/outboundgroup/smart_dependencies.go
@@ -0,0 +1,111 @@
+package outboundgroup
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	"github.com/metacubex/mihomo/component/geodata"
+	"github.com/metacubex/mihomo/component/smart/lightgbm"
+	"github.com/metacubex/mihomo/log"
+	"github.com/metacubex/mihomo/tunnel"
+)
+
+type smartDependency struct {
+	sync.Mutex
+	users  int
+	ctx    context.Context
+	cancel context.CancelFunc
+	wake   chan struct{}
+}
+
+func (d *smartDependency) acquire(parent context.Context) {
+	d.Lock()
+	defer d.Unlock()
+	if d.users == 0 {
+		d.ctx, d.cancel = context.WithCancel(parent)
+	}
+	d.users++
+	select {
+	case d.wake <- struct{}{}:
+	default:
+	}
+}
+
+func (d *smartDependency) release() {
+	d.Lock()
+	defer d.Unlock()
+	d.users--
+	if d.users == 0 {
+		d.cancel()
+	}
+}
+
+func (d *smartDependency) current() context.Context {
+	d.Lock()
+	defer d.Unlock()
+	if d.users == 0 {
+		return nil
+	}
+	return d.ctx
+}
+
+func (s *Smart) startOptionalDependencies() {
+	s.startDependencyWorker(&smartGlobals.model, func(ctx context.Context) {
+		if err := lightgbm.EnsureModel(ctx); err != nil && ctx.Err() == nil {
+			log.Warnln("[Smart] Model unavailable, using formula scoring: %v", err)
+		}
+	})
+	s.startDependencyWorker(&smartGlobals.asn, func(ctx context.Context) {
+		if err := geodata.InitASNContext(ctx); err != nil {
+			if ctx.Err() == nil {
+				smartGlobals.asnError.Store(err.Error())
+				log.Warnln("[Smart] ASN unavailable, using ordinary target selection: %v", err)
+			}
+		} else {
+			smartGlobals.asnError.Store("")
+		}
+	})
+}
+
+// Validation never sets tunnel.Running, so it performs no optional downloads.
+// Closing the last group cancels in-flight requests as well as pending retries.
+func (s *Smart) startDependencyWorker(dependency *smartDependency, task func(context.Context)) {
+	dependency.wake = make(chan struct{}, 1)
+	wake := dependency.wake
+	s.wg.Add(1)
+	go func() {
+		defer s.wg.Done()
+		startup := time.NewTicker(100 * time.Millisecond)
+		defer startup.Stop()
+		for tunnel.Status() != tunnel.Running {
+			select {
+			case <-s.ctx.Done():
+				return
+			case <-startup.C:
+			}
+		}
+		select {
+		case <-wake:
+		default:
+		}
+		retry := time.NewTicker(time.Minute)
+		defer retry.Stop()
+		for {
+			if s.ctx.Err() != nil {
+				return
+			}
+			if tunnel.Status() == tunnel.Running {
+				if ctx := dependency.current(); ctx != nil {
+					task(ctx)
+				}
+			}
+			select {
+			case <-s.ctx.Done():
+				return
+			case <-wake:
+			case <-retry.C:
+			}
+		}
+	}()
+}
