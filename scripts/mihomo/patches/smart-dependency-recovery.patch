+)
+
+type smartRecoveryProxy struct {
+	nativeSelectionProxy
+	direct *outbound.Direct
+}
+
+func (p *smartRecoveryProxy) Type() C.AdapterType { return C.Direct }
+func (p *smartRecoveryProxy) SupportUDP() bool    { return true }
+func (p *smartRecoveryProxy) DialContext(ctx context.Context, m *C.Metadata) (C.Conn, error) {
+	return p.direct.DialContext(ctx, m)
+}
+func (p *smartRecoveryProxy) ListenPacketContext(ctx context.Context, m *C.Metadata) (C.PacketConn, error) {
+	return p.direct.ListenPacketContext(ctx, m)
+}
+
+func TestSmartFailedAutomaticPinRecoversCurrentRequest(t *testing.T) {
+	for _, network := range []C.NetWork{C.TCP, C.UDP} {
+		t.Run(network.String(), func(t *testing.T) {
+			smart.InitCache()
+			a := &smartTransferFailProxy{nativeSelectionProxy: nativeSelectionProxy{name: "A", alive: true}}
+			b := &smartRecoveryProxy{nativeSelectionProxy: nativeSelectionProxy{name: "B", alive: true}, direct: outbound.NewDirectWithOption(outbound.DirectOption{Name: "B"})}
+			s := &Smart{GroupBase: nativeSelectionBase(C.Smart, a, b), store: &smart.Store{}, configName: t.Name(), ctx: context.Background()}
+			s.exitWatch = smart.NewExitWatcher(smart.ExitWatcherOptions{Name: s.Name(), Config: s.configName, Store: s.store})
+			m := &C.Metadata{DstIP: netip.MustParseAddr("127.0.0.1"), DstIPASN: "unknown", NetWork: network}
+			s.selectProxies(m, s.GetProxies(false))
+			s.store.StoreUnwrapResult(s.Name(), s.configName, s.unwrapKey(m), []C.Proxy{a})
+			ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+			defer cancel()
+			payload := []byte("smart-recovered")
+			if network == C.TCP {
+				listener, err := net.Listen("tcp", "127.0.0.1:0")
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer listener.Close()
+				go func() {
+					conn, err := listener.Accept()
+					if err != nil {
+						return
+					}
+					defer conn.Close()
+					_, _ = io.Copy(conn, conn)
+				}()
+				m.DstPort = uint16(listener.Addr().(*net.TCPAddr).Port)
+				conn, err := s.DialContext(ctx, m)
+				if err != nil {
+					t.Fatal("same request did not recover:", err)
+				}
+				defer conn.Close()
+				_ = conn.SetDeadline(time.Now().Add(time.Second))
+				if _, err = conn.Write(payload); err != nil {
+					t.Fatal(err)
+				}
+				buffer := make([]byte, len(payload))
+				if _, err = io.ReadFull(conn, buffer); err != nil || string(buffer) != string(payload) {
+					t.Fatalf("TCP recovery lost application data: %q %v", buffer, err)
+				}
+			} else {
+				server, err := net.ListenPacket("udp", "127.0.0.1:0")
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer server.Close()
+				go func() {
+					buffer := make([]byte, 128)
+					n, address, err := server.ReadFrom(buffer)
+					if err == nil {
+						_, _ = server.WriteTo(buffer[:n], address)
+					}
+				}()
+				m.DstPort = uint16(server.LocalAddr().(*net.UDPAddr).Port)
+				conn, err := s.ListenPacketContext(ctx, m)
+				if err != nil {
+					t.Fatal("same packet request did not recover:", err)
+				}
+				defer conn.Close()
+				_ = conn.SetDeadline(time.Now().Add(time.Second))
+				if _, err = conn.WriteTo(payload, server.LocalAddr()); err != nil {
+					t.Fatal(err)
+				}
+				buffer := make([]byte, 128)
+				n, _, err := conn.ReadFrom(buffer)
+				if err != nil || string(buffer[:n]) != string(payload) {
+					t.Fatalf("UDP recovery lost application data: %q %v", buffer[:n], err)
+				}
+			}
+			if names, _ := s.store.GetUnwrapResult(s.Name(), s.configName, s.unwrapKey(m)); len(names) != 1 || names[0] != "B" {
+				t.Fatalf("successful recovery did not update future connections: %v", names)
+			}
+		})
+	}
+}
