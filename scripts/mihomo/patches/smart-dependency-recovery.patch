+package config_test
+
+import (
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/adapter/outboundgroup"
+	"github.com/metacubex/mihomo/config"
+	C "github.com/metacubex/mihomo/constant"
+	_ "github.com/metacubex/mihomo/hub/executor"
+	"github.com/metacubex/mihomo/tunnel"
+)
+
+func TestSmartParsingDoesNotDownloadOptionalDependencies(t *testing.T) {
+	oldHome, oldStatus := C.Path.HomeDir(), tunnel.Status()
+	C.SetHomeDir(t.TempDir())
+	defer C.SetHomeDir(oldHome)
+	tunnel.OnRunning() // Parsing during a live reload also must remain local.
+	defer func() {
+		switch oldStatus {
+		case tunnel.Running:
+			tunnel.OnRunning()
+		case tunnel.Inner:
+			tunnel.OnInnerLoading()
+		default:
+			tunnel.OnSuspend()
+		}
+	}()
+	var requests atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests.Add(1)
+		w.WriteHeader(http.StatusServiceUnavailable)
+	}))
+	defer server.Close()
+	content := fmt.Sprintf(`mixed-port: 0
+lgbm-auto-update: false
+lgbm-url: %s/model
+geox-url:
+  asn: %s/asn
+proxy-groups:
+  - name: Smart
+    type: smart
+    proxies: [DIRECT]
+    uselightgbm: true
+    prefer-asn: true
+rules: ['MATCH,Smart']
+`, server.URL, server.URL)
+	cfg, err := config.Parse([]byte(content))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		for _, proxy := range cfg.Proxies {
+			if group, ok := proxy.Adapter().(*outboundgroup.Smart); ok {
+				_ = group.Close()
+			}
+		}
+	}()
+	time.Sleep(200 * time.Millisecond)
+	if requests.Load() != 0 {
+		t.Fatalf("unapplied configuration started %d downloads", requests.Load())
+	}
+}
