@@ -0,0 +1,55 @@
+package geodata
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	C "github.com/metacubex/mihomo/constant"
+)
+
+func TestSmartASNDownloadValidationAndCancellation(t *testing.T) {
+	previousHome, previousURL := C.Path.HomeDir(), ASNUrl()
+	C.SetHomeDir(t.TempDir())
+	defer func() { C.SetHomeDir(previousHome); SetASNUrl(previousURL) }()
+	const original = "keep existing data on download failure"
+	if err := os.WriteFile(C.Path.ASN(), []byte(original), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	for _, name := range []string{"http-error", "invalid", "empty", "oversized", "cancelled"} {
+		t.Run(name, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				switch name {
+				case "http-error":
+					w.WriteHeader(http.StatusServiceUnavailable)
