+
+func TestSmartModelUpdatesBoundedAndCancellable(t *testing.T) {
+	lifecycleHome(t)
+	oldURL := LgbmUrl()
+	smartModel, modelOnce = nil, sync.Once{}
+	t.Cleanup(func() { smartModel, modelOnce = nil, sync.Once{}; SetLgbmUrl(oldURL) })
+	if err := os.WriteFile(C.Path.SmartModel(), []byte(lifecycleModel), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	m := GetModel()
+	for _, name := range []string{"oversized", "cancelled"} {
+		t.Run(name, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if name == "oversized" {
+					w.Header().Set("Content-Length", "67108865")
+				} else {
+					<-r.Context().Done()
+				}
+			}))
+			defer server.Close()
+			SetLgbmUrl(server.URL)
+			ctx, cancel := context.WithTimeout(context.Background(), 150*time.Millisecond)
+			defer cancel()
+			if err := UpdateModel(ctx); err == nil {
+				t.Fatal("unsafe model update accepted")
+			}
+			if ready, _ := m.Status(); !ready {
+				t.Fatal("failed update disabled working inference")
+			}
+			if data, err := os.ReadFile(C.Path.SmartModel()); err != nil || string(data) != lifecycleModel {
+				t.Fatalf("working model replaced: %v", err)
+			}
+		})
+	}
+	entered, release := make(chan struct{}), make(chan struct{})
+	var releaseOnce sync.Once
+	unblock := func() { releaseOnce.Do(func() { close(release) }) }
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		close(entered)
+		select {
+		case <-release:
+			_, _ = w.Write([]byte(lifecycleModel))
+		case <-r.Context().Done():
+		}
+	}))
+	defer server.Close()
+	defer unblock()
+	SetLgbmUrl(server.URL)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	finished := make(chan error, 1)
+	go func() { finished <- UpdateModel(ctx) }()
+	select {
+	case <-entered:
+	case <-time.After(time.Second):
+		t.Fatal("update did not start")
+	}
+	waiter, stop := context.WithTimeout(context.Background(), 50*time.Millisecond)
+	defer stop()
+	if err := UpdateModel(waiter); !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("queued update ignored cancellation: %v", err)
+	}
+	// An old response must not overwrite settings from a newly applied config.
+	SetLgbmUrl(server.URL + "/new-config")
+	unblock()
+	select {
+	case err := <-finished:
+		if err == nil || !strings.Contains(err.Error(), "settings changed") {
+			t.Fatalf("obsolete update was installed: %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("update did not release its worker")
+	}
+}
+
+func TestSmartNonFiniteModelPredictionFallsBack(t *testing.T) {
+	lifecycleHome(t)
+	data := strings.Replace(lifecycleModel, "leaf_value=0.43 0.59", "leaf_value=+Inf +Inf", 1)
+	if err := os.WriteFile(C.Path.SmartModel(), []byte(data), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	m := &WeightModel{}
+	if err := m.loadModel(C.Path.SmartModel()); err != nil {
+		t.Fatal(err)
+	}
+	input := &smart.ModelInput{Success: 3, IsTCP: true, ConnectTime: 5, Latency: 10}
+	if weight, used := m.PredictWeight(input, 1); used || math.IsInf(weight, 0) || math.IsNaN(weight) {
+		t.Fatalf("non-finite inference escaped to node scoring: %v %v", weight, used)
+	}
+}
