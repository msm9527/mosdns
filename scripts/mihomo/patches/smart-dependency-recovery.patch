@@ -0,0 +1,96 @@
+package outboundgroup
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/component/smart"
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/metacubex/mihomo/tunnel"
+)
+
+func TestSmartOptionalDependenciesLifecycle(t *testing.T) {
+	previous := tunnel.Status()
+	tunnel.OnSuspend()
+	defer func() {
+		switch previous {
+		case tunnel.Running:
+			tunnel.OnRunning()
+		case tunnel.Inner:
+			tunnel.OnInnerLoading()
+		default:
+			tunnel.OnSuspend()
+		}
+	}()
+	ctx, cancel := context.WithCancel(context.Background())
+	worker := &Smart{ctx: ctx}
+	defer func() { cancel(); worker.wg.Wait() }()
+	dependency := &smartDependency{}
+	started := make(chan context.Context, 4)
+	worker.startDependencyWorker(dependency, func(ctx context.Context) {
+		started <- ctx
+		<-ctx.Done()
+	})
+	dependency.acquire(ctx)
+	select {
+	case <-started:
+		t.Fatal("configuration validation started an optional network task")
+	case <-time.After(150 * time.Millisecond):
+	}
+	tunnel.OnRunning()
+	var first context.Context
+	select {
+	case first = <-started:
+	case <-time.After(2 * time.Second):
+		t.Fatal("dependency did not initialize after the proxy started")
+	}
+	// A reload parses replacements before closing the old groups.
+	dependency.acquire(ctx)
+	dependency.release()
+	if first.Err() != nil {
+		t.Fatal("closing an old group cancelled its replacement's request")
+	}
+	select {
+	case <-started:
+		t.Fatal("replacement spawned a duplicate download")
+	default:
+	}
+	dependency.release()
+	select {
+	case <-first.Done():
+	case <-time.After(time.Second):
+		t.Fatal("disabling the last user did not cancel its download")
+	}
+	dependency.acquire(ctx)
+	select {
+	case next := <-started:
+		if next == first || next.Err() != nil {
+			t.Fatal("re-enabling the feature reused a cancelled request")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("re-enabling the dependency did not retry")
+	}
+	dependency.release()
+}
+
+func TestSmartStagedGroupsPreserveActiveDependencyOwners(t *testing.T) {
+	group := func() *Smart {
+		ctx, cancel := context.WithCancel(context.Background())
+		return &Smart{GroupBase: NewGroupBase(GroupBaseOption{Name: t.Name(), Type: C.Smart}), store: &smart.Store{}, ctx: ctx, cancel: cancel, useLightGBM: true, preferASN: true}
+	}
+	active, staged := group(), group()
+	active.acquireGlobalTasks()
+	active.ActivateDependencies()
+	defer active.Close()
+	modelContext, asnContext := smartGlobals.model.current(), smartGlobals.asn.current()
+	staged.acquireGlobalTasks()
+	_ = staged.Close()
+	if smartGlobals.model.current() != modelContext || smartGlobals.asn.current() != asnContext || modelContext.Err() != nil || asnContext.Err() != nil {
+		t.Fatal("closing an unapplied configuration changed active dependency ownership")
+	}
+	_ = active.Close()
+	if modelContext.Err() == nil || asnContext.Err() == nil || smartGlobals.worker != nil {
+		t.Fatal("closing the final active group leaked its optional workers")
+	}
+}
