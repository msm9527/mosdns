+func TestSmartManualDialFailurePreservesAutomaticPin(t *testing.T) {
+	for _, network := range []C.NetWork{C.TCP, C.UDP} {
+		t.Run(network.String(), func(t *testing.T) {
+			smart.InitCache()
+			a := &smartTransferFailProxy{nativeSelectionProxy: nativeSelectionProxy{name: "A", alive: true}}
+			b := &smartTransferFailProxy{nativeSelectionProxy: nativeSelectionProxy{name: "B", alive: true}}
+			s := &Smart{GroupBase: nativeSelectionBase(C.Smart, a, b), store: &smart.Store{}, configName: t.Name(), ctx: context.Background()}
+			metadata := &C.Metadata{Host: t.Name() + ".example", DstIPASN: "unknown", NetWork: network}
+			s.ForceSet("B")
+			selected, err := s.selectDialProxies(context.Background(), metadata)
+			if err != nil || !selected.manual {
+				t.Fatal("missing manual snapshot")
+			}
+			s.store.StoreUnwrapResult(s.Name(), s.configName, s.unwrapKey(metadata), []C.Proxy{a})
+			if network == C.UDP {
+				_, err = s.ListenPacketContext(context.Background(), metadata)
+			} else {
+				_, err = s.DialContext(context.Background(), metadata)
+			}
+			if err == nil {
+				t.Fatal("failing proxy unexpectedly connected")
+			}
+			names, _ := s.store.GetUnwrapResult(s.Name(), s.configName, s.unwrapKey(metadata))
+			if len(names) != 1 || names[0] != "A" {
+				t.Fatalf("manual failure deleted automatic pin: %v", names)
+			}
+		})
+	}
+}
