+
+type smartTransferTracker struct {
+	C.Connection
+	id     string
+	info   statistic.TrackerInfo
+	closed int
+}
+
+func (t *smartTransferTracker) ID() string                   { return t.id }
+func (t *smartTransferTracker) Info() *statistic.TrackerInfo { return &t.info }
+func (t *smartTransferTracker) Chains() C.Chain              { return t.info.Chain }
+func (t *smartTransferTracker) Close() error                 { t.closed++; return nil }
+
+func TestSmartAutomaticWinnerPreservesHealthyStream(t *testing.T) {
+	smart.InitCache()
+	s := &Smart{GroupBase: NewGroupBase(GroupBaseOption{Name: t.Name(), Type: C.Smart}), store: &smart.Store{}, configName: t.Name()}
+	a, b := &nativeSelectionProxy{name: "A"}, &nativeSelectionProxy{name: "B"}
+	metadata := &C.Metadata{SmartTarget: t.Name(), UUID: "new", NetWork: C.TCP}
+	s.adoptUnwrapWinner(metadata, a)
+	tracker := &smartTransferTracker{id: t.Name(), info: statistic.TrackerInfo{Metadata: &C.Metadata{SmartTarget: t.Name()}, Chain: C.Chain{"A", s.Name()}}}
+	statistic.DefaultManager.Join(tracker)
+	defer statistic.DefaultManager.Leave(tracker)
+	s.adoptUnwrapWinner(metadata, b)
+	if tracker.closed != 0 {
+		t.Fatalf("new automatic winner closed %d healthy in-flight streams", tracker.closed)
+	}
+	names, _ := s.store.GetUnwrapResult(s.Name(), s.configName, s.unwrapKey(metadata))
+	if len(names) != 1 || names[0] != "B" {
+		t.Fatalf("future connections did not adopt B: %v", names)
+	}
+	s.closeSameConnection(metadata, "", metadata.SmartTarget, true)
+	if tracker.closed != 1 || tracker.info.Metadata.SmartBlock != "degraded" {
+		t.Fatal("confirmed degradation no longer closes affected streams")
+	}
+}
+
+func TestSmartManualSelectionKeepsAutomaticPin(t *testing.T) {
+	smart.InitCache()
+	a, b := &nativeSelectionProxy{name: "A", alive: true}, &nativeSelectionProxy{name: "B", alive: true}
+	s := &Smart{GroupBase: nativeSelectionBase(C.Smart, a, b), store: &smart.Store{}, configName: t.Name()}
+	metadata := &C.Metadata{Host: t.Name() + ".example", DstIPASN: "unknown", NetWork: C.TCP}
+	s.ForceSet("B")
+	selection, err := s.selectDialProxies(context.Background(), metadata)
+	if err != nil || len(selection.proxies) != 1 || selection.proxies[0] != b || !selection.pinned || !selection.keepPin || !selection.manual || selection.release != nil {
+		t.Fatalf("manual selection altered automatic pin lifecycle: %v %v %v %v", selection.proxies, selection.pinned, selection.keepPin, err)
+	}
+	s.adoptUnwrapWinner(metadata, a)
+	s.ForceSet("A")
+	selection, err = s.selectDialProxies(context.Background(), metadata)
+	if err != nil || !selection.keepPin || !selection.manual {
+		t.Fatal("manual TCP selection may rewrite automatic pin")
+	}
+	metadata.NetWork = C.UDP
+	selection, err = s.selectDialProxies(context.Background(), metadata)
+	if err != nil || !selection.keepPin || !selection.manual {
+		t.Fatal("manual UDP selection may rewrite automatic pin")
+	}
+}
+
+func TestSmartUDPWinnerDoesNotCloseTCPStream(t *testing.T) {
+	smart.InitCache()
+	s := &Smart{GroupBase: NewGroupBase(GroupBaseOption{Name: t.Name(), Type: C.Smart}), store: &smart.Store{}, configName: t.Name()}
+	a, b := &nativeSelectionProxy{name: "A"}, &nativeSelectionProxy{name: "B"}
+	tcp := &C.Metadata{SmartTarget: t.Name(), UUID: "new-tcp", NetWork: C.TCP}
+	udp := &C.Metadata{SmartTarget: t.Name(), UUID: "new-udp", NetWork: C.UDP}
+	s.adoptUnwrapWinner(tcp, a)
+	tracker := &smartTransferTracker{id: t.Name(), info: statistic.TrackerInfo{Metadata: tcp, Chain: C.Chain{"A", s.Name()}}}
+	statistic.DefaultManager.Join(tracker)
+	defer statistic.DefaultManager.Leave(tracker)
+	s.adoptUnwrapWinner(udp, b)
+	names, _ := s.store.GetUnwrapResult(s.Name(), s.configName, s.unwrapKey(tcp))
+	udpNames, _ := s.store.GetUnwrapResult(s.Name(), s.configName, s.unwrapKey(udp))
+	if tracker.closed != 0 || len(names) != 1 || names[0] != "A" || len(udpNames) != 1 || udpNames[0] != "B" {
+		t.Fatalf("UDP winner damaged TCP stream/pin: closes=%d TCP=%v UDP=%v", tracker.closed, names, udpNames)
+	}
+}
+
+func smartTransferGroup(t *testing.T) (*Smart, C.Proxy) {
+	t.Helper()
+	smart.InitCache()
+	a, b := &nativeSelectionProxy{name: "A", alive: true}, &nativeSelectionProxy{name: "B", alive: true}
+	s := &Smart{GroupBase: nativeSelectionBase(C.Smart, a, b), store: &smart.Store{}, configName: t.Name(), ctx: context.Background()}
+	s.exitWatch = smart.NewExitWatcher(smart.ExitWatcherOptions{Name: s.Name(), Config: s.configName, Store: s.store})
+	return s, b
+}
+
+func TestSmartFirstDialWaitersReadCommittedWinner(t *testing.T) {
+	s, b := smartTransferGroup(t)
+	metadata := func() *C.Metadata {
+		return &C.Metadata{Host: t.Name() + ".example", DstIPASN: "unknown", NetWork: C.TCP}
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	first := metadata()
+	selection, err := s.selectDialProxies(ctx, first)
+	if err != nil || selection.pinned || selection.release == nil {
+		t.Fatalf("missing initial-dial leader: %v %v", selection.pinned, err)
+	}
+	defer selection.release()
+	var workers sync.WaitGroup
+	workers.Add(32)
+	results := make(chan error, 32)
+	for i := 0; i < 32; i++ {
+		go func() {
+			defer workers.Done()
+			selected, err := s.selectDialProxies(ctx, metadata())
+			if selected.release != nil {
+				selected.release()
+			}
+			if err != nil {
+				results <- err
+				return
+			}
+			if len(selected.proxies) != 1 || selected.proxies[0] != b || !selected.pinned || selected.release != nil {
+				results <- errors.New("waiter did not read the committed first-dial winner")
+			}
+		}()
+	}
+	s.adoptUnwrapWinner(first, b)
+	selection.release()
+	workers.Wait()
+	close(results)
+	for err := range results {
+		t.Error(err)
+	}
+	s.pinDials.Range(func(_, _ any) bool { t.Error("completed dial retained a coordination entry"); return true })
+}
+
+func TestSmartFirstDialCancellationAndFailureCleanup(t *testing.T) {
+	s := &Smart{}
+	leader, err := s.acquirePinDial(context.Background(), "target")
+	if err != nil || leader == nil {
+		t.Fatal(err)
+	}
+	canceled, cancel := context.WithCancel(context.Background())
+	waiter := make(chan error, 1)
+	go func() { _, err := s.acquirePinDial(canceled, "target"); waiter <- err }()
+	cancel()
+	select {
+	case err := <-waiter:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("caller cancellation left a blocked first-dial waiter")
+	}
+	// TCP and UDP own independent decisions even while the other network waits.
+	udp, err := s.acquirePinDial(context.Background(), smart.NetScopedTarget("target", true))
+	if err != nil || udp == nil {
+		t.Fatal("TCP first dial blocked UDP")
+	}
+	udp()
+	leader() // A failed leader releases just as a successful leader does.
+	leader() // Duplicate cleanup must not remove or panic another owner's entry.
+	replacement, err := s.acquirePinDial(context.Background(), "target")
+	if err != nil || replacement == nil {
+		t.Fatal("failed first dial blocked its successor")
+	}
+	defer replacement()
+	leader()
+	if _, ok := s.pinDials.Load("target"); !ok {
+		t.Fatal("stale cleanup deleted the successor")
+	}
+	groupCtx, stopGroup := context.WithCancel(context.Background())
+	s.ctx = groupCtx
+	go func() { _, err := s.acquirePinDial(context.Background(), "target"); waiter <- err }()
+	stopGroup()
+	select {
+	case err := <-waiter:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("group reload left a blocked first-dial waiter")
+	}
+}
