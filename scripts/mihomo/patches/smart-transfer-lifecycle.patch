@@ -0,0 +1,89 @@
+package outboundgroup
+
+import (
+	"context"
+	"errors"
+	"sync"
+
+	C "github.com/metacubex/mihomo/constant"
+)
+
+type smartPinDial struct {
+	done chan struct{}
+	once sync.Once
+}
+
+// acquirePinDial owns only the first-dial decision, never a physical connection.
+// Waiters must reselect after it completes, so they read the committed pin and
+// create their own connection. Entries disappear on success and failure alike.
+func (s *Smart) acquirePinDial(ctx context.Context, key string) (release func(), err error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	var closed <-chan struct{}
+	if s.ctx != nil {
+		closed = s.ctx.Done()
+		if err := s.ctx.Err(); err != nil {
+			return nil, err
+		}
+	}
+	next := &smartPinDial{done: make(chan struct{})}
+	active, loaded := s.pinDials.LoadOrStore(key, next)
+	if !loaded {
+		return func() {
+			next.once.Do(func() {
+				s.pinDials.CompareAndDelete(key, next)
+				close(next.done)
+			})
+		}, nil
+	}
+	select {
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	case <-closed:
+		return nil, s.ctx.Err()
+	case <-active.(*smartPinDial).done:
+		return nil, nil
+	}
+}
+
+type smartDialSelection struct {
+	proxies                 []C.Proxy
+	pinned, keepPin, manual bool
+	release                 func()
+}
+
+func (s *Smart) selectDialProxies(ctx context.Context, metadata *C.Metadata) (smartDialSelection, error) {
+	for attempt := 0; attempt < maxRetries; attempt++ {
+		if err := ctx.Err(); err != nil {
+			return smartDialSelection{}, err
+		}
+		if s.ctx != nil && s.ctx.Err() != nil {
+			return smartDialSelection{}, s.ctx.Err()
+		}
+		proxies, pinned, keepPin, manual := s.selectProxyCandidates(metadata, s.GetProxies(true))
+		if pinned || keepPin {
+			return smartDialSelection{proxies: proxies, pinned: pinned, keepPin: keepPin, manual: manual}, nil
+		}
+		key := s.unwrapKey(metadata)
+		release, err := s.acquirePinDial(ctx, key)
+		if err != nil {
+			return smartDialSelection{}, err
+		}
+		if release == nil {
+			continue // another caller finished; read its committed pin
+		}
+		// A winner may have committed between our first selection and acquisition.
+		proxies, pinned, keepPin, manual = s.selectProxyCandidates(metadata, s.GetProxies(true))
+		if !pinned && !keepPin && s.unwrapKey(metadata) != key {
+			release()
+			continue // site/ASN ownership changed while this decision was acquired
+		}
+		if pinned || keepPin {
+			release()
+			release = nil
+		}
+		return smartDialSelection{proxies: proxies, pinned: pinned, keepPin: keepPin, manual: manual, release: release}, nil
+	}
+	return smartDialSelection{}, errors.New("Smart first-dial retry budget exhausted")
+}
