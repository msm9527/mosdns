diff --git a/adapter/outboundgroup/smart_stalled.go b/adapter/outboundgroup/smart_stalled.go
new file mode 100644
--- /dev/null
+++ b/adapter/outboundgroup/smart_stalled.go
@@ -0,0 +1,51 @@
+package outboundgroup
+
+import (
+	"sync"
+
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/metacubex/sing/common"
+	"github.com/metacubex/sing/common/network"
+)
+
+// A finished TCP stream that sent a small request supplies bounded failure
+// evidence. Large uploads and internal probes need their own response/error
+// semantics; silence alone must not classify those as a failed destination.
+const smartStalledMaxUploadMB = 64.0 / 1024
+
+func smartConnectionStalled(metadata *C.Metadata, q connQuality) bool {
+	return metadata.NetWork == C.TCP && metadata.Type != C.INNER &&
+		q.duration > stalledConnectionGrace.Milliseconds() &&
+		q.uploadMB > 0 && q.uploadMB <= smartStalledMaxUploadMB && q.downloadMB == 0
+}
+
+// A half-close finishes only the upload. Sampling at that point would record a
+// healthy request as unanswered before its server has sent the response.
+// Keep this policy local to Smart TCP metrics; other callback users and UDP
+// retain their existing lifecycle.
+type smartCloseCallbackConn struct {
+	C.Conn
+	closeFunc func()
+	closeOnce sync.Once
+}
+
+func newSmartCloseCallbackConn(conn C.Conn, callback func()) C.Conn {
+	return &smartCloseCallbackConn{Conn: conn, closeFunc: callback}
+}
+
+func (c *smartCloseCallbackConn) Close() error {
+	c.closeOnce.Do(c.closeFunc)
+	return c.Conn.Close()
+}
+
+func (c *smartCloseCallbackConn) CloseWrite() error {
+	if writer, ok := common.Cast[network.WriteCloser](c.Conn); ok {
+		return writer.CloseWrite()
+	}
+	// Protocols without half-close support finish the whole stream here.
+	return c.Close()
+}
+
+func (c *smartCloseCallbackConn) ReaderReplaceable() bool { return true }
+func (c *smartCloseCallbackConn) WriterReplaceable() bool { return true }
+func (c *smartCloseCallbackConn) Upstream() any           { return c.Conn }
