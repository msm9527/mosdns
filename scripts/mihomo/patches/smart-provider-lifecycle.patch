+// Stop retired refreshers before new providers initialize the same cache path.
+// Finalizers cannot guarantee this: connections and groups may retain providers
+// long after a successful hot reload.
+func closeReplacedProviders[T P.Provider](current, next map[string]T) {
+	for name, provider := range current {
+		if replacement, ok := next[name]; ok && P.Provider(provider) == P.Provider(replacement) {
+			continue
+		}
+		if closer, ok := any(provider).(interface{ Close() error }); ok {
+			if err := closer.Close(); err != nil {
+				log.Warnln("[Provider] %s close error: %v", name, err)
+			}
+		}
+	}
+}
+
 func updateRules(rules []C.Rule, subRules map[string][]C.Rule, ruleProviders map[string]P.RuleProvider) {
 	tunnel.UpdateRules(rules, subRules, ruleProviders)
 }
