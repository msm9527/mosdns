diff --git a/component/resource/smart_provider_lifecycle_test.go b/component/resource/smart_provider_lifecycle_test.go
new file mode 100644
--- /dev/null
+++ b/component/resource/smart_provider_lifecycle_test.go
@@ -0,0 +1,126 @@
+package resource
+
+import (
+	"context"
+	"errors"
+	"os"
+	"path/filepath"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/common/utils"
+	P "github.com/metacubex/mihomo/constant/provider"
+)
+
+type smartCacheVehicle struct {
+	path         string
+	body         []byte
+	readStarted  chan struct{}
+	releaseRead  chan struct{}
+	writeStarted chan struct{}
+	releaseWrite chan struct{}
+	reads        atomic.Int32
+}
+
+func (v *smartCacheVehicle) Type() P.VehicleType { return P.HTTP }
+func (v *smartCacheVehicle) Path() string        { return v.path }
+func (v *smartCacheVehicle) Url() string         { return "https://provider.invalid/sub" }
+func (v *smartCacheVehicle) Proxy() string       { return "DIRECT" }
+func (v *smartCacheVehicle) Read(context.Context, utils.HashType) ([]byte, utils.HashType, error) {
+	v.reads.Add(1)
+	if v.readStarted != nil {
+		close(v.readStarted)
+		<-v.releaseRead
+	}
+	// Deliberately deliver a late successful result after cancellation.
+	return v.body, utils.MakeHash(v.body), nil
+}
+func (v *smartCacheVehicle) Write(body []byte) error {
+	if v.writeStarted != nil {
+		close(v.writeStarted)
+		<-v.releaseWrite
+	}
+	return os.WriteFile(v.path, body, 0600)
+}
+func smartCacheParser(body []byte) (string, error) { return string(body), nil }
+
+func TestSmartRetiredFetcherCannotOverwriteCache(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "provider.yaml")
+	old := &smartCacheVehicle{path: path, body: []byte("old"), readStarted: make(chan struct{}), releaseRead: make(chan struct{})}
+	var updates atomic.Int32
+	f := NewFetcher("old", time.Hour, old, nil, smartCacheParser, func(string) { updates.Add(1) })
+	done := make(chan error, 1)
+	go func() { _, _, err := f.Update(); done <- err }()
+	<-old.readStarted
+	if err := f.Close(); err != nil {
+		t.Fatal(err)
+	}
+	fresh := NewFetcher("new", time.Hour, &smartCacheVehicle{path: path, body: []byte("new")}, nil, smartCacheParser, nil)
+	defer fresh.Close()
+	if _, _, err := fresh.Update(); err != nil {
+		t.Fatal(err)
+	}
+	stat, err := os.Stat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	close(old.releaseRead)
+	if err := <-done; !errors.Is(err, context.Canceled) {
+		t.Fatalf("late response: %v", err)
+	}
+	if _, _, err := f.SideUpdate([]byte("stale push")); !errors.Is(err, context.Canceled) {
+		t.Fatalf("retired side update: %v", err)
+	}
+	if _, _, err := f.Update(); !errors.Is(err, context.Canceled) {
+		t.Fatalf("retired pull: %v", err)
+	}
+	if old.reads.Load() != 1 || updates.Load() != 0 {
+		t.Fatal("retired provider kept working")
+	}
+	body, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	after, err := os.Stat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(body) != "new" || !after.ModTime().Equal(stat.ModTime()) {
+		t.Fatal("retired provider changed active cache")
+	}
+}
+
+func TestSmartFetcherCloseDrainsCacheCommit(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "provider.yaml")
+	vehicle := &smartCacheVehicle{path: path, body: []byte("old"), writeStarted: make(chan struct{}), releaseWrite: make(chan struct{})}
+	f := NewFetcher("old", time.Hour, vehicle, nil, smartCacheParser, nil)
+	updated := make(chan struct{})
+	go func() { defer close(updated); _, _, _ = f.Update() }()
+	<-vehicle.writeStarted
+	closed := make(chan struct{})
+	go func() { _ = f.Close(); close(closed) }()
+	<-f.ctx.Done()
+	select {
+	case <-closed:
+		t.Fatal("Close returned during an active cache commit")
+	default:
+	}
+	close(vehicle.releaseWrite)
+	<-closed
+	<-updated
+	fresh := NewFetcher("new", time.Hour, &smartCacheVehicle{path: path, body: []byte("new")}, nil, smartCacheParser, nil)
+	defer fresh.Close()
+	if _, _, err := fresh.Update(); err != nil {
+		t.Fatal(err)
+	}
+	// Repeated Close and same-hash SideUpdate must not touch the active file.
+	_ = f.Close()
+	if _, _, err := f.SideUpdate([]byte("old")); !errors.Is(err, context.Canceled) {
+		t.Fatalf("closed update: %v", err)
+	}
+	body, err := os.ReadFile(path)
+	if err != nil || string(body) != "new" {
+		t.Fatalf("cache lost: %q %v", body, err)
+	}
+}
diff --git a/hub/executor/smart_provider_lifecycle_test.go b/hub/executor/smart_provider_lifecycle_test.go
new file mode 100644
--- /dev/null
+++ b/hub/executor/smart_provider_lifecycle_test.go
@@ -0,0 +1,64 @@
+package executor
+
+import (
+	"context"
+	"errors"
+	"path/filepath"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/component/resource"
+	P "github.com/metacubex/mihomo/constant/provider"
+)
+
+type smartLifecycleProvider struct {
+	*resource.Fetcher[string]
+	closed atomic.Int32
+}
+
+func (p *smartLifecycleProvider) Type() P.ProviderType { return P.Proxy }
+func (p *smartLifecycleProvider) Initial() error       { _, err := p.Fetcher.Initial(); return err }
+func (p *smartLifecycleProvider) Update() error        { _, _, err := p.Fetcher.Update(); return err }
+func (p *smartLifecycleProvider) Close() error         { p.closed.Add(1); return p.Fetcher.Close() }
+func newSmartLifecycleProvider(t *testing.T, name string) *smartLifecycleProvider {
+	f := resource.NewFetcher(name, time.Hour, resource.NewFileVehicle(filepath.Join(t.TempDir(), name)), nil, func(b []byte) (string, error) { return string(b), nil }, nil)
+	return &smartLifecycleProvider{Fetcher: f}
+}
+
+func TestSmartProviderReplacementRetiresRefreshers(t *testing.T) {
+	// Keep a strong reference: correctness cannot depend on GC/finalizer timing.
+	old := newSmartLifecycleProvider(t, "sub")
+	removed := newSmartLifecycleProvider(t, "removed")
+	next := newSmartLifecycleProvider(t, "sub")
+	defer next.Close()
+	closeReplacedProviders(map[string]P.Provider{"sub": old, "removed": removed}, map[string]P.Provider{"sub": next})
+	if old.closed.Load() != 1 || removed.closed.Load() != 1 || next.closed.Load() != 0 {
+		t.Fatal("wrong provider lifecycle")
+	}
+	if _, _, err := old.SideUpdate([]byte("old")); !errors.Is(err, context.Canceled) {
+		t.Fatalf("retired provider writable: %v", err)
+	}
+	if _, _, err := next.SideUpdate([]byte("new")); err != nil {
+		t.Fatalf("replacement unusable: %v", err)
+	}
+}
+
+func TestSmartProviderReplacementPreservesRetainedProviders(t *testing.T) {
+	retained := newSmartLifecycleProvider(t, "sub")
+	current := map[string]P.Provider{"sub": retained}
+	closeReplacedProviders(current, map[string]P.Provider{"sub": retained})
+	if retained.closed.Load() != 0 {
+		t.Fatal("retained provider was canceled")
+	}
+	if _, _, err := retained.SideUpdate([]byte("retained")); err != nil {
+		t.Fatal(err)
+	}
+	closeReplacedProviders(current, map[string]P.Provider(nil))
+	if retained.closed.Load() != 1 {
+		t.Fatal("shutdown did not retire provider")
+	}
+	if _, _, err := retained.SideUpdate([]byte("after shutdown")); !errors.Is(err, context.Canceled) {
+		t.Fatal(err)
+	}
+}
