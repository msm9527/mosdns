+++ b/config/direct_system_proxy_test.go
@@ -0,0 +1,68 @@
+package config
+
+import (
+	"slices"
+	"testing"
+
+	"github.com/metacubex/mihomo/adapter/provider"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+func TestDirectSystemExcludedFromAutomaticProxyGroups(t *testing.T) {
+	for _, helper := range []string{"MSM-HOME-DIRECT", "custom-system-route"} {
+		t.Run(helper, func(t *testing.T) {
+			proxies, providers, err := parseProxies(&RawConfig{
+				Proxy: []map[string]any{
+					{"name": helper, "type": "direct-system", "routing-mark": 17},
+					{"name": "user-direct", "type": "direct", "interface-name": "designated-wan"},
+					{"name": "user-node", "type": "socks5", "server": "127.0.0.1", "port": 1080},
+				},
+				ProxyGroup: []map[string]any{
+					{"name": "automatic", "type": "url-test", "include-all-proxies": true, "url": "https://example.invalid", "interval": 0},
+					{"name": "include-everything", "type": "select", "include-all": true},
+					{"name": "deliberate", "type": "select", "proxies": []string{helper}},
+				},
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if proxies[helper] == nil || proxies[helper].ProxyInfo().RoutingMark != 17 {
+				t.Fatal("explicit system-route target must remain available to listener/rule lookups")
+			}
+			if proxies["user-direct"].ProxyInfo().Interface != "designated-wan" {
+				t.Fatal("ordinary direct binding changed")
+			}
+			for _, group := range []string{"automatic", "include-everything", "GLOBAL"} {
+				members := directSystemTestGroupMembers(t, proxies[group])
+				if slices.Contains(members, helper) || !slices.Contains(members, "user-direct") || !slices.Contains(members, "user-node") {
+					t.Fatalf("%s automatic members include helper or lost ordinary nodes: %v", group, members)
+				}
+			}
+			members := directSystemTestProxyNames(providers[provider.ReservedName].Proxies())
+			if slices.Contains(members, helper) || !slices.Contains(members, "user-direct") || !slices.Contains(members, "user-node") {
+				t.Fatalf("compatible health-check inventory changed: %v", members)
+			}
+			members = directSystemTestGroupMembers(t, proxies["deliberate"])
+			if len(members) != 1 || members[0] != helper {
+				t.Fatalf("explicit group reference must remain usable: %v", members)
+			}
+		})
+	}
+}
+
+func directSystemTestGroupMembers(t *testing.T, proxy C.Proxy) []string {
+	t.Helper()
+	group, ok := proxy.Adapter().(interface{ GetProxies(bool) []C.Proxy })
+	if !ok {
+		t.Fatalf("%s is not an inspectable proxy group", proxy.Name())
+	}
+	return directSystemTestProxyNames(group.GetProxies(false))
+}
+
+func directSystemTestProxyNames(proxies []C.Proxy) []string {
+	names := make([]string, 0, len(proxies))
+	for _, proxy := range proxies {
+		names = append(names, proxy.Name())
+	}
+	return names
+}
