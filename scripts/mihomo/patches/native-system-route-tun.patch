@@ -0,0 +1,32 @@
+package sing_tun
+
+import (
+	"errors"
+
+	LC "github.com/metacubex/mihomo/listener/config"
+	tun "github.com/metacubex/sing-tun"
+)
+
+// sing-tun v0.4.28 reserves the final NOP at start+10. Keep the dependency
+// namespace gates in sync when changing the pinned version.
+const systemRouteRuleWindow = 10
+
+// ValidateSystemRouteOptions also runs in fresh -t processes, before there is
+// any live listener or kernel state. Invalid combinations must not pass the
+// manager's preflight and fail only after it has stopped a working core.
+func ValidateSystemRouteOptions(options LC.Tun) error {
+	if !options.Enable || options.SystemRouteMark == 0 {
+		return nil
+	}
+	if !options.AutoRoute || options.AutoRedirect || options.FileDescriptor != 0 {
+		return errors.New("system-route-mark requires auto-route without auto-redirect or file-descriptor")
+	}
+	index := options.IPRoute2RuleIndex
+	if index == 0 {
+		index = tun.DefaultIPRoute2RuleIndex
+	}
+	if index <= 1 || index > 32765-systemRouteRuleWindow {
+		return errors.New("system-route-mark requires a rule index between 2 and 32755")
+	}
+	return nil
+}
