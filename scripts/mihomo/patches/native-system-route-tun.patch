new file mode 100644
index 0000000..dfa2520
--- /dev/null
+++ b/listener/sing_tun/system_route_snapshot_linux.go
@@ -0,0 +1,50 @@
+//go:build linux
+
+package sing_tun
+
+import (
+	"errors"
+
+	"github.com/sagernet/netlink/nl"
+	"golang.org/x/sys/unix"
+)
+
+type systemRouteKernelRule struct {
+	family      int
+	priority    int
+	fingerprint string
+}
+
+// netlink.RuleList omits the kernel action/type and protocol. Retain the
+// complete RTM_NEWRULE body so a user replacement (for example, NOP ->
+// blackhole at the same priority) cannot be mistaken for an owned rule.
+func systemRouteKernelRules() ([]systemRouteKernelRule, error) {
+	req := nl.NewNetlinkRequest(unix.RTM_GETRULE, unix.NLM_F_DUMP|unix.NLM_F_REQUEST)
+	req.AddData(nl.NewIfInfomsg(unix.AF_UNSPEC))
+	messages, err := req.Execute(unix.NETLINK_ROUTE, unix.RTM_NEWRULE)
+	if err != nil {
+		return nil, err
+	}
+	rules := make([]systemRouteKernelRule, 0, len(messages))
+	for _, data := range messages {
+		if len(data) < unix.SizeofRtMsg {
+			return nil, errors.New("short kernel routing-rule message")
+		}
+		message := nl.DeserializeRtMsg(data)
+		attributes, err := nl.ParseRouteAttr(data[message.Len():])
+		if err != nil {
+			return nil, err
+		}
+		rule := systemRouteKernelRule{family: int(message.Family), priority: -1, fingerprint: string(data)}
+		for _, attribute := range attributes {
+			if attribute.Attr.Type == nl.FRA_PRIORITY {
+				if len(attribute.Value) < 4 {
+					return nil, errors.New("short kernel routing-rule priority")
+				}
+				rule.priority = int(nl.NativeEndian().Uint32(attribute.Value[:4]))
+			}
+		}
+		rules = append(rules, rule)
+	}
+	return rules, nil
+}
