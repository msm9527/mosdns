+++ b/listener/tun_system_route_linux_test.go
@@ -0,0 +1,152 @@
+//go:build linux
+
+package listener
+
+import (
+	"fmt"
+	"net/netip"
+	"os"
+	"os/exec"
+	"reflect"
+	"testing"
+
+	C "github.com/metacubex/mihomo/constant"
+	_ "github.com/metacubex/mihomo/dns" // Initializes SystemResolver, as the application does.
+	LC "github.com/metacubex/mihomo/listener/config"
+	"github.com/metacubex/mihomo/tunnel"
+	"github.com/sagernet/netlink"
+	"golang.org/x/sys/unix"
+)
+
+func TestTunSystemRouteReloadNamespace(t *testing.T) {
+	if os.Getenv("MIHOMO_TUN_RELOAD_CHILD") == "1" {
+		testTunSystemRouteReload(t)
+		return
+	}
+	if os.Getenv("MIHOMO_TUN_RULES_INTEGRATION") != "1" {
+		t.Skip("set MIHOMO_TUN_RULES_INTEGRATION=1 in an isolated CAP_NET_ADMIN/CAP_SYS_ADMIN container")
+	}
+	ns := fmt.Sprintf("msm-reload-%d", os.Getpid())
+	command := func(args ...string) {
+		t.Helper()
+		if out, err := exec.Command(args[0], args[1:]...).CombinedOutput(); err != nil {
+			t.Fatalf("%v: %v %s", args, err, out)
+		}
+	}
+	command("ip", "netns", "add", ns)
+	t.Cleanup(func() { _ = exec.Command("ip", "netns", "del", ns).Run() })
+	command("ip", "-n", ns, "link", "set", "lo", "up")
+	command("ip", "-n", ns, "link", "add", "uplink", "type", "dummy")
+	command("ip", "-n", ns, "addr", "add", "10.90.0.1/24", "dev", "uplink")
+	command("ip", "-n", ns, "addr", "add", "fd90::1/64", "dev", "uplink", "nodad")
+	command("ip", "-n", ns, "link", "set", "uplink", "up")
+	command("ip", "-n", ns, "route", "add", "default", "via", "10.90.0.254")
+	command("ip", "-n", ns, "-6", "route", "add", "default", "via", "fd90::fe")
+	executable, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	child := exec.Command("ip", "netns", "exec", ns, executable, "-test.run=^TestTunSystemRouteReloadNamespace$", "-test.v", "-test.timeout=30s")
+	child.Env = append(os.Environ(), "MIHOMO_TUN_RELOAD_CHILD=1")
+	if out, err := child.CombinedOutput(); err != nil {
+		t.Fatalf("reload namespace: %v\n%s", err, out)
+	} else {
+		t.Log(string(out))
+	}
+}
+
+func testTunSystemRouteReload(t *testing.T) {
+	snapshot := func() []netlink.Rule {
+		t.Helper()
+		rules, err := netlink.RuleList(unix.AF_UNSPEC)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return rules
+	}
+	baseline := snapshot()
+	conf := LC.Tun{Enable: true, Device: "reload_tun", Stack: C.TunSystem,
+		AutoRoute: true, AutoDetectInterface: true, SystemRouteMark: 17,
+		IPRoute2RuleIndex: 11000, MTU: 1500,
+		Inet4Address: []netip.Prefix{netip.MustParsePrefix("198.18.0.1/30")},
+		Inet6Address: []netip.Prefix{netip.MustParsePrefix("fdfe:abcd::1/126")},
+		RouteAddress: []netip.Prefix{netip.MustParsePrefix("198.18.0.0/15"), netip.MustParsePrefix("fdfe:abcd::/64")}}
+	ReCreateTun(conf, tunnel.Tunnel)
+	if tunLister == nil || !LastTunConf.Enable {
+		t.Fatal("initial TUN failed")
+	}
+	t.Cleanup(closeTunListener)
+	first := tunLister
+	ReCreateTun(conf, tunnel.Tunnel)
+	if tunLister != first {
+		t.Fatal("unchanged configuration unnecessarily recreated listener")
+	}
+	conf.MTU = 1400
+	ReCreateTun(conf, tunnel.Tunnel)
+	if tunLister == nil || tunLister == first || LastTunConf.MTU != 1400 {
+		t.Fatal("normal hot reload failed")
+	}
+	conflict := netlink.NewRule()
+	conflict.Family, conflict.Priority, conflict.Table = unix.AF_INET, 11005, 201
+	if err := netlink.RuleAdd(conflict); err != nil {
+		t.Fatal(err)
+	}
+	before := snapshot()
+	current := tunLister
+	conf.MTU = 1300
+	if err := ValidateTunSystemRouteReplacement(conf); err == nil {
+		t.Fatal("parse-time validation accepted conflicting user rule")
+	}
+	ReCreateTun(conf, tunnel.Tunnel)
+	if tunLister != current || LastTunConf.MTU != 1400 || !reflect.DeepEqual(before, snapshot()) {
+		t.Fatal("rejected replacement disrupted old listener or user rules")
+	}
+	if err := netlink.RuleDel(conflict); err != nil {
+		t.Fatal(err)
+	}
+	// A replacement of our NOP by a user blackhole differs only in the
+	// kernel action. The dependency's RuleList does not expose that action.
+	nop := netlink.NewRule()
+	nop.Family, nop.Priority = unix.AF_INET, 11010
+	if err := netlink.RuleDel(nop); err != nil {
+		t.Fatal(err)
+	}
+	blackhole := *nop
+	blackhole.Type = unix.FR_ACT_BLACKHOLE
+	if err := netlink.RuleAdd(&blackhole); err != nil {
+		t.Fatal(err)
+	}
+	if err := ValidateTunSystemRouteReplacement(conf); err == nil {
+		t.Fatal("user blackhole replacement was mistaken for owned NOP")
+	}
+	if err := netlink.RuleDel(&blackhole); err != nil {
+		t.Fatal(err)
+	}
+	if err := netlink.RuleAdd(nop); err != nil {
+		t.Fatal(err)
+	}
+	// Force a post-preflight tun.New failure and verify automatic restoration.
+	before = snapshot()
+	broken := conf
+	broken.Device = "invalid/tun/name"
+	ReCreateTun(broken, tunnel.Tunnel)
+	if tunLister == nil || LastTunConf.Device != "reload_tun" || LastTunConf.MTU != 1400 || !reflect.DeepEqual(before, snapshot()) {
+		t.Fatal("failed replacement did not restore old TUN configuration/rules")
+	}
+	conf.MTU = 1400
+	conf.SystemRouteMark = 0
+	ReCreateTun(conf, tunnel.Tunnel)
+	if tunLister == nil || LastTunConf.SystemRouteMark != 0 {
+		t.Fatal("removing system-route adapter failed")
+	}
+	conf.SystemRouteMark = 17
+	ReCreateTun(conf, tunnel.Tunnel)
+	if tunLister == nil || LastTunConf.SystemRouteMark != 17 {
+		t.Fatal("enabling system-route adapter on existing TUN failed")
+	}
+	conf.Enable = false
+	ReCreateTun(conf, tunnel.Tunnel)
+	if tunLister != nil || LastTunConf.Enable || !reflect.DeepEqual(baseline, snapshot()) {
+		t.Fatal("TUN shutdown left residual rules")
+	}
+}
diff --git a/listener/sing_tun/system_route_identity_linux.go b/listener/sing_tun/system_route_identity_linux.go
