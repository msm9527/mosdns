+// Derive the bypass mark from explicit static system-route adapters. Keeping
+// this relationship in the core makes TUN recreation/removal track proxy
+// configuration atomically, without a manager rewriting the user's TUN block.
+func resolveTunSystemRouteMark(rawTun RawTun, rawProxies []map[string]any, proxies map[string]C.Proxy) (RawTun, error) {
+	for _, mapping := range rawProxies {
+		if mapping["type"] != "direct-system" {
+			continue
+		}
+		name, _ := mapping["name"].(string)
+		proxy := proxies[name]
+		if proxy == nil {
+			return rawTun, fmt.Errorf("direct-system proxy %q was not parsed", name)
+		}
+		mark := proxy.ProxyInfo().RoutingMark
+		if mark <= 0 || uint64(mark) > uint64(^uint32(0)) {
+			return rawTun, fmt.Errorf("direct-system proxy %q requires an explicit non-zero uint32 routing-mark", name)
+		}
+		if rawTun.SystemRouteMark != 0 && rawTun.SystemRouteMark != uint32(mark) {
+			return rawTun, fmt.Errorf("direct-system proxy %q routing-mark %#x conflicts with TUN system-route-mark %#x", name, mark, rawTun.SystemRouteMark)
+		}
+		rawTun.SystemRouteMark = uint32(mark)
+	}
+	return rawTun, nil
+}
