+//go:build !linux
+
+package sing_tun
+
+import (
+	"strings"
+	"testing"
+
+	LC "github.com/metacubex/mihomo/listener/config"
+)
+
+func TestSystemRouteNonLinuxStaticValidation(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		options LC.Tun
+		wantErr bool
+	}{
+		{"marked-enabled", LC.Tun{Enable: true, AutoRoute: true, SystemRouteMark: 17}, true},
+		{"marked-disabled", LC.Tun{Enable: false, SystemRouteMark: 17}, false},
+		{"ordinary-enabled", LC.Tun{Enable: true}, false},
+		{"ordinary-disabled", LC.Tun{}, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			err := ValidateSystemRouteOptions(tc.options)
+			if (err != nil) != tc.wantErr {
+				t.Fatalf("preflight error=%v wantErr=%v", err, tc.wantErr)
+			}
+			if replacementErr := (&Listener{}).CheckSystemRouteReplacement(tc.options); (replacementErr != nil) != tc.wantErr {
+				t.Fatalf("replacement error=%v wantErr=%v", replacementErr, tc.wantErr)
+			}
+			if tc.wantErr && !strings.Contains(err.Error(), "only supported on Linux") {
+				t.Fatalf("unclear platform error: %v", err)
+			}
+		})
+	}
+}
