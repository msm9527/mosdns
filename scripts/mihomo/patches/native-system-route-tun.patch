index 0000000..e65372f
--- /dev/null
+++ b/listener/sing_tun/system_route_identity_linux.go
@@ -0,0 +1,154 @@
+//go:build linux
+
+package sing_tun
+
+import (
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+
+	"github.com/sagernet/netlink"
+	"github.com/sagernet/netlink/nl"
+	"golang.org/x/sys/unix"
+)
+
+type systemRouteIdentity struct {
+	Header     string
+	Attributes map[uint16]string
+}
+
+// Only these flags are derived from changing kernel link/goto availability.
+// Invert, the rule action, protocol and every attribute remain part of identity.
+const systemRouteDerivedFlags uint32 = 4 | 8 | 16
+
+func systemRouteIdentityFromRaw(raw string) (string, error) {
+	data := []byte(raw)
+	if len(data) < unix.SizeofRtMsg {
+		return "", errors.New("short routing rule")
+	}
+	header := append([]byte(nil), data[:unix.SizeofRtMsg]...)
+	flags := nl.NativeEndian().Uint32(header[8:12]) &^ systemRouteDerivedFlags
+	nl.NativeEndian().PutUint32(header[8:12], flags)
+	attrs, err := nl.ParseRouteAttr(data[unix.SizeofRtMsg:])
+	if err != nil {
+		return "", err
+	}
+	identity := systemRouteIdentity{Header: hex.EncodeToString(header), Attributes: map[uint16]string{}}
+	for _, attr := range attrs {
+		if _, exists := identity.Attributes[attr.Attr.Type]; exists {
+			return "", errors.New("duplicate routing rule attribute")
+		}
+		identity.Attributes[attr.Attr.Type] = hex.EncodeToString(attr.Value)
+	}
+	// Older kernels do not emit FRA_PROTOCOL; their effective protocol is zero.
+	if _, ok := identity.Attributes[21]; !ok {
+		identity.Attributes[21] = "00"
+	}
+	value, err := json.Marshal(identity)
+	return string(value), err
+}
+
+func systemRouteIdentityFromPlan(r *netlink.Rule) (string, error) {
+	header := make([]byte, unix.SizeofRtMsg)
+	header[0] = byte(r.Family)
+	header[3] = byte(r.Tos)
+	action := r.Type
+	if action == 0 {
+		if r.Table >= 0 {
+			action = unix.FR_ACT_TO_TBL
+		} else if r.Goto >= 0 {
+			action = unix.FR_ACT_GOTO
+		} else {
+			action = unix.FR_ACT_NOP
+		}
+	}
+	header[7] = action
+	table := r.Table
+	if table < 0 {
+		table = 0
+	}
+	if table < 256 {
+		header[4] = byte(table)
+	} else {
+		header[4] = unix.RT_TABLE_COMPAT
+	}
+	if r.Invert {
+		nl.NativeEndian().PutUint32(header[8:12], 2)
+	}
+	attrs := map[uint16]string{}
+	put32 := func(key uint16, value uint32) {
+		b := make([]byte, 4)
+		nl.NativeEndian().PutUint32(b, value)
+		attrs[key] = hex.EncodeToString(b)
+	}
+	put32(nl.FRA_TABLE, uint32(table))
+	put32(nl.FRA_SUPPRESS_PREFIXLEN, uint32(r.SuppressPrefixlen))
+	attrs[21] = "00"
+	if r.Priority >= 0 {
+		put32(nl.FRA_PRIORITY, uint32(r.Priority))
+	}
+	if r.MarkSet {
+		put32(nl.FRA_FWMARK, r.Mark)
+		mask := uint32(r.Mask)
+		if r.Mask < 0 {
+			mask = ^uint32(0)
+		}
+		put32(nl.FRA_FWMASK, mask)
+	} else if r.Mask >= 0 {
+		put32(nl.FRA_FWMASK, uint32(r.Mask))
+	}
+	if r.Goto >= 0 {
+		put32(nl.FRA_GOTO, uint32(r.Goto))
+	}
+	if r.Src.IsValid() {
+		header[2] = byte(r.Src.Bits())
+		attrs[nl.FRA_SRC] = hex.EncodeToString(r.Src.Addr().AsSlice())
+	}
+	if r.Dst.IsValid() {
+		header[1] = byte(r.Dst.Bits())
+		attrs[nl.FRA_DST] = hex.EncodeToString(r.Dst.Addr().AsSlice())
+	}
+	if r.IifName != "" {
+		attrs[nl.FRA_IIFNAME] = hex.EncodeToString([]byte(r.IifName + "\x00"))
+	}
+	if r.OifName != "" {
+		attrs[nl.FRA_OIFNAME] = hex.EncodeToString([]byte(r.OifName + "\x00"))
+	}
+	if r.SuppressIfgroup >= 0 {
+		put32(nl.FRA_SUPPRESS_IFGROUP, uint32(r.SuppressIfgroup))
+	}
+	if r.Flow >= 0 {
+		put32(nl.FRA_FLOW, uint32(r.Flow))
+	}
+	for key, ports := range map[uint16]*netlink.RulePortRange{nl.FRA_DPORT_RANGE: r.Dport, nl.FRA_SPORT_RANGE: r.Sport} {
+		if ports != nil {
+			b := make([]byte, 4)
+			nl.NativeEndian().PutUint16(b[:2], ports.Start)
+			nl.NativeEndian().PutUint16(b[2:], ports.End)
+			attrs[key] = hex.EncodeToString(b)
+		}
+	}
+	if r.UIDRange != nil {
+		b := make([]byte, 8)
+		nl.NativeEndian().PutUint32(b[:4], r.UIDRange.Start)
+		nl.NativeEndian().PutUint32(b[4:], r.UIDRange.End)
+		attrs[nl.FRA_UID_RANGE] = hex.EncodeToString(b)
+	}
+	if r.TunID != 0 || r.IPProto != 0 {
+		return "", fmt.Errorf("unsupported planned routing selector")
+	}
+	result, err := json.Marshal(systemRouteIdentity{Header: hex.EncodeToString(header), Attributes: attrs})
+	return string(result), err
+}
+
+type systemRouteRawMessage []byte
+
+func (m systemRouteRawMessage) Len() int          { return len(m) }
+func (m systemRouteRawMessage) Serialize() []byte { return m }
+func deleteSystemRouteRaw(rule systemRouteKernelRule) error {
+	req := nl.NewNetlinkRequest(unix.RTM_DELRULE, unix.NLM_F_ACK)
+	req.AddData(systemRouteRawMessage(rule.fingerprint))
+	_, err := req.Execute(unix.NETLINK_ROUTE, 0)
+	return err
+}
diff --git a/listener/sing_tun/system_route_journal_linux.go b/listener/sing_tun/system_route_journal_linux.go
new file mode 100644
index 0000000..fe5f702
--- /dev/null
+++ b/listener/sing_tun/system_route_journal_linux.go
@@ -0,0 +1,175 @@
+//go:build linux
+
+package sing_tun
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+
+	C "github.com/metacubex/mihomo/constant"
+	"golang.org/x/sys/unix"
+)
+
+type systemRouteJournalRule struct {
+	Family   int
+	Priority int
+	Identity string
+	Raw      []byte `json:",omitempty"`
+}
+type systemRouteJournal struct {
+	Version   int
+	Namespace string
+	BootID    string
+	PID       int
+	StartTime string
+	Index     int
+	Device    string
+	Rules     []systemRouteJournalRule
+	Complete  bool
+}
+type systemRouteJournalOwner struct {
+	file  *os.File
+	path  string
+	state systemRouteJournal
+}
+
+func systemRouteProcessStat(pid int) (string, string, error) {
+	data, err := os.ReadFile(fmt.Sprintf("/proc/%d/stat", pid))
+	if err != nil {
+		return "", "", err
+	}
+	end := strings.LastIndexByte(string(data), ')')
+	if end < 0 {
+		return "", "", errors.New("invalid process stat")
+	}
+	fields := strings.Fields(string(data[end+1:]))
+	if len(fields) <= 19 {
+		return "", "", errors.New("short process stat")
+	}
+	return fields[19], fields[0], nil
+}
+
+func lockSystemRouteJournal(index int) (*systemRouteJournalOwner, error) {
+	file, err := os.Open("/proc/self/ns/net")
+	if err != nil {
+		return nil, err
+	}
+	if err = unix.Flock(int(file.Fd()), unix.LOCK_EX|unix.LOCK_NB); err != nil {
+		file.Close()
+		return nil, fmt.Errorf("system-route namespace already owned: %w", err)
+	}
+	fail := func(err error) (*systemRouteJournalOwner, error) { file.Close(); return nil, err }
+	var stat unix.Stat_t
+	if err = unix.Fstat(int(file.Fd()), &stat); err != nil {
+		return fail(err)
+	}
+	boot, err := os.ReadFile("/proc/sys/kernel/random/boot_id")
+	if err != nil {
+		return fail(err)
+	}
+	start, _, err := systemRouteProcessStat(os.Getpid())
+	if err != nil {
+		return fail(err)
+	}
+	namespace := strconv.FormatUint(uint64(stat.Dev), 10) + "-" + strconv.FormatUint(stat.Ino, 10)
+	return &systemRouteJournalOwner{file: file, path: filepath.Join(C.Path.HomeDir(), fmt.Sprintf(".system-route-%s-%d.json", namespace, index)), state: systemRouteJournal{Version: 1, Namespace: namespace, BootID: strings.TrimSpace(string(boot)), PID: os.Getpid(), StartTime: start, Index: index}}, nil
+}
+
+func (o *systemRouteJournalOwner) read() (*systemRouteJournal, error) {
+	fd, err := unix.Open(o.path, unix.O_RDONLY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	f := os.NewFile(uintptr(fd), o.path)
+	defer f.Close()
+	info, err := f.Stat()
+	if err != nil {
+		return nil, err
+	}
+	// os.FileInfo uses syscall.Stat_t on Linux; Fstat avoids a package-layout assumption.
+	var st unix.Stat_t
+	if err = unix.Fstat(fd, &st); err != nil {
+		return nil, err
+	}
+	if !info.Mode().IsRegular() || st.Uid != uint32(os.Geteuid()) || info.Mode().Perm()&0o077 != 0 {
+		return nil, errors.New("unsafe system-route journal owner or permissions")
+	}
+	data, err := io.ReadAll(io.LimitReader(f, 4<<20))
+	if err != nil {
+		return nil, err
+	}
+	var state systemRouteJournal
+	if err = json.Unmarshal(data, &state); err != nil {
+		return nil, fmt.Errorf("corrupt system-route journal: %w", err)
+	}
+	if state.Version != 1 || state.Namespace != o.state.Namespace || state.Index != o.state.Index || state.Index <= 1 || state.Index > 32765-systemRouteRuleWindow || state.BootID == "" || state.PID <= 0 || state.StartTime == "" || len(state.Rules) == 0 {
+		return nil, errors.New("system-route journal identity mismatch")
+	}
+	if state.BootID != o.state.BootID {
+		return &state, nil
+	}
+	if start, status, err := systemRouteProcessStat(state.PID); err == nil && start == state.StartTime && status != "Z" && status != "X" {
+		return nil, errors.New("system-route journal owner is still alive")
+	} else if err != nil && !errors.Is(err, os.ErrNotExist) {
+		return nil, fmt.Errorf("cannot verify system-route journal owner: %w", err)
+	}
+	return &state, nil
+}
+
+func (o *systemRouteJournalOwner) write() error {
+	data, err := json.Marshal(o.state)
+	if err != nil {
+		return err
+	}
+	dir := filepath.Dir(o.path)
+	if err = os.MkdirAll(dir, 0o700); err != nil {
+		return err
+	}
+	f, err := os.CreateTemp(dir, ".system-route-tmp-")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(f.Name())
+	if _, err = f.Write(data); err == nil {
+		err = f.Sync()
+	}
+	err = errors.Join(err, f.Close())
+	if err != nil {
+		return err
+	}
+	if err = os.Rename(f.Name(), o.path); err != nil {
+		return err
+	}
+	return syncSystemRouteDir(dir)
+}
+func syncSystemRouteDir(dir string) error {
+	f, err := os.Open(dir)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	return f.Sync()
+}
+func (o *systemRouteJournalOwner) remove() error {
+	if err := os.Remove(o.path); err != nil && !errors.Is(err, os.ErrNotExist) {
+		return err
+	}
+	return syncSystemRouteDir(filepath.Dir(o.path))
+}
+func (o *systemRouteJournalOwner) unlock() error {
+	if o.file == nil {
+		return nil
+	}
+	err := o.file.Close()
+	o.file = nil
+	return err
+}
diff --git a/listener/sing_tun/system_route_journal_namespace_linux_test.go b/listener/sing_tun/system_route_journal_namespace_linux_test.go
new file mode 100644
index 0000000..227a7e4
--- /dev/null
+++ b/listener/sing_tun/system_route_journal_namespace_linux_test.go
@@ -0,0 +1,299 @@
+//go:build linux
+
+package sing_tun
+
+import (
+	"fmt"
+	"net/netip"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"testing"
+	"time"
+
+	C "github.com/metacubex/mihomo/constant"
+	LC "github.com/metacubex/mihomo/listener/config"
+	tun "github.com/metacubex/sing-tun"
+	"github.com/metacubex/sing/common/ranges"
+	"github.com/sagernet/netlink"
+)
+
+func TestSystemRouteJournalNamespace(t *testing.T) {
+	if mode := os.Getenv("MIHOMO_JOURNAL_CHILD"); mode != "" {
+		C.SetHomeDir(os.Getenv("MIHOMO_JOURNAL_HOME"))
+		if mode == "suite" {
+			testSystemRouteJournalSuite(t)
+		} else {
+			testSystemRouteJournalCrashOwner(t, mode)
+		}
+		return
+	}
+	if os.Getenv("MIHOMO_TUN_RULES_INTEGRATION") != "1" {
+		t.Skip("requires isolated privileged namespace")
+	}
+	ns := fmt.Sprintf("msm-journal-%d", os.Getpid())
+	command := func(args ...string) {
+		t.Helper()
+		if out, err := exec.Command(args[0], args[1:]...).CombinedOutput(); err != nil {
+			t.Fatalf("%v: %v %s", args, err, out)
+		}
+	}
+	command("ip", "netns", "add", ns)
+	t.Cleanup(func() { _ = exec.Command("ip", "netns", "del", ns).Run() })
+	command("ip", "-n", ns, "link", "set", "lo", "up")
+	command("ip", "-n", ns, "link", "add", "uplink", "type", "dummy")
+	command("ip", "-n", ns, "addr", "add", "10.91.0.1/24", "dev", "uplink")
+	command("ip", "-n", ns, "link", "set", "uplink", "up")
+	executable, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	child := exec.Command("ip", "netns", "exec", ns, executable, "-test.run=^TestSystemRouteJournalNamespace$", "-test.v", "-test.timeout=60s")
+	child.Env = append(os.Environ(), "MIHOMO_JOURNAL_CHILD=suite", "MIHOMO_JOURNAL_HOME="+t.TempDir())
+	if out, err := child.CombinedOutput(); err != nil {
+		t.Fatalf("journal namespace: %v\n%s", err, out)
+	} else {
+		t.Log(string(out))
+	}
+}
+
+func journalTestOptions() tun.Options {
+	return tun.Options{Name: "journal_tun", MTU: 1500, AutoRoute: true, IPRoute2TableIndex: 2022, IPRoute2RuleIndex: 12000,
+		Inet4Address: []netip.Prefix{netip.MustParsePrefix("198.18.0.1/30")}, Inet6Address: []netip.Prefix{netip.MustParsePrefix("fdfe:abcd::1/126")}}
+}
+func journalTestListener(o tun.Options, bypass interface{ Close() error }, device tun.Tun) *Listener {
+	return &Listener{options: LC.Tun{Enable: true, AutoRoute: true, SystemRouteMark: 17, IPRoute2RuleIndex: o.IPRoute2RuleIndex, Inet4Address: o.Inet4Address, Inet6Address: o.Inet6Address}, tunIf: device, systemRouteBypass: bypass}
+}
+func journalTestOpen(t *testing.T, o tun.Options) *Listener {
+	t.Helper()
+	bypass, err := newSystemRouteBypass(LC.Tun{SystemRouteMark: 17}, o)
+	if err != nil {
+		t.Fatal(err)
+	}
+	device, err := tun.New(o)
+	if err != nil {
+		_ = bypass.Close()
+		t.Fatal(err)
+	}
+	active := journalTestListener(o, bypass, device)
+	if err := recordSystemRouteOwnedRules(active); err != nil {
+		_ = device.Close()
+		_ = bypass.Close()
+		t.Fatal(err)
+	}
+	return active
+}
+func journalTestClose(t *testing.T, active *Listener) {
+	t.Helper()
+	if err := active.tunIf.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := active.systemRouteBypass.Close(); err != nil {
+		t.Fatal(err)
+	}
+}
+func journalTestAssertClean(t *testing.T, baseline []netlink.Rule) {
+	t.Helper()
+	if now := systemRouteRuleSnapshot(t); !reflect.DeepEqual(now, baseline) {
+		t.Fatalf("owned residue or changed user rules: before=%v after=%v", baseline, now)
+	}
+	paths, err := systemRouteJournalPaths()
+	if err != nil || len(paths) > 0 {
+		t.Fatalf("journal leaked: %v %v", paths, err)
+	}
+}
+func testSystemRouteJournalSuite(t *testing.T) {
+	baseline := systemRouteRuleSnapshot(t)
+	for _, variant := range []string{"dual", "v4", "v6", "strict-v4", "strict-v6", "ports-uid", "include", "exclude", "all", "all-v4", "all-v6"} {
+		t.Run("plan-"+variant, func(t *testing.T) {
+			o := journalTestOptions()
+			switch variant {
+			case "v4", "strict-v4", "all-v4":
+				o.Inet6Address = nil
+			case "v6", "strict-v6", "all-v6":
+				o.Inet4Address = nil
+			}
+			if variant == "strict-v4" || variant == "strict-v6" {
+				o.StrictRoute = true
+			}
+			if variant == "ports-uid" || variant == "all" || variant == "all-v4" || variant == "all-v6" {
+				o.ExcludeSrcPort = []ranges.Range[uint16]{{Start: 1000, End: 2000}}
+				o.ExcludeDstPort = []ranges.Range[uint16]{{Start: 3000, End: 4000}}
+				o.ExcludeUID = []ranges.Range[uint32]{{Start: 100, End: 200}}
+			}
+			if variant == "include" || variant == "all" || variant == "all-v4" || variant == "all-v6" {
+				o.IncludeInterface = []string{"uplink", "lo"}
+			}
+			if variant == "exclude" {
+				o.ExcludeInterface = []string{"uplink"}
+			}
+			active := journalTestOpen(t, o)
+			journalTestClose(t, active)
+			journalTestAssertClean(t, baseline)
+		})
+	}
+	for _, stage := range []string{"bypass", "partial", "plan", "full"} {
+		for _, recovery := range []string{"restart", "new-index", "disable", "remove-mark"} {
+			t.Run(stage+"-"+recovery, func(t *testing.T) {
+				process := journalTestCrash(t, stage)
+				defer process.Wait() // Deliberately recover while the killed owner is still a zombie.
+				if recovery == "disable" {
+					if err := CleanupSystemRouteJournal(LC.Tun{}); err != nil {
+						t.Fatal(err)
+					}
+				} else if recovery == "remove-mark" {
+					if _, err := newSystemRouteBypass(LC.Tun{}, journalTestOptions()); err != nil {
+						t.Fatal(err)
+					}
+				} else {
+					o := journalTestOptions()
+					if recovery == "new-index" {
+						o.IPRoute2RuleIndex = 13000
+					}
+					active := journalTestOpen(t, o)
+					journalTestClose(t, active)
+				}
+				journalTestAssertClean(t, baseline)
+			})
+		}
+	}
+	t.Run("interrupted-recovery", func(t *testing.T) {
+		process := journalTestCrash(t, "full")
+		defer process.Wait()
+		rules, err := systemRouteKernelRules()
+		if err != nil {
+			t.Fatal(err)
+		}
+		for i, rule := range systemRouteJournalWindow(rules, 12000) {
+			if i%2 == 0 {
+				if err := deleteSystemRouteRaw(rule); err != nil {
+					t.Fatal(err)
+				}
+			}
+		}
+		if err := CleanupSystemRouteJournal(LC.Tun{}); err != nil {
+			t.Fatal(err)
+		}
+		journalTestAssertClean(t, baseline)
+	})
+	t.Run("special-home-directory", func(t *testing.T) {
+		home := C.Path.HomeDir()
+		C.SetHomeDir(filepath.Join(home, "state[prod]"))
+		defer C.SetHomeDir(home)
+		active := journalTestOpen(t, journalTestOptions())
+		journalTestClose(t, active)
+		journalTestAssertClean(t, baseline)
+	})
+	t.Run("ordinary-no-journal", func(t *testing.T) {
+		owner, err := lockSystemRouteJournal(12000)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer owner.unlock()
+		home := C.Path.HomeDir()
+		missing := filepath.Join(home, "absent")
+		C.SetHomeDir(missing)
+		defer C.SetHomeDir(home)
+		if _, err := newSystemRouteBypass(LC.Tun{}, journalTestOptions()); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := os.Stat(missing); !os.IsNotExist(err) {
+			t.Fatalf("ordinary configuration created state: %v", err)
+		}
+	})
+	testSystemRouteJournalRejections(t, baseline)
+}
+func journalTestCrash(t *testing.T, stage string) *exec.Cmd {
+	t.Helper()
+	ready := filepath.Join(C.Path.HomeDir(), "ready")
+	_ = os.Remove(ready)
+	executable, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	process := exec.Command(executable, "-test.run=^TestSystemRouteJournalNamespace$", "-test.timeout=30s")
+	process.Env = append(os.Environ(), "MIHOMO_JOURNAL_CHILD="+stage)
+	logFile, err := os.Create(filepath.Join(C.Path.HomeDir(), "child.log"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer logFile.Close()
+	process.Stdout, process.Stderr = logFile, logFile
+	if err := process.Start(); err != nil {
+		t.Fatal(err)
+	}
+	for deadline := time.Now().Add(5 * time.Second); ; {
+		if _, err := os.Stat(ready); err == nil {
+			break
+		}
+		if time.Now().After(deadline) {
+			_ = process.Process.Kill()
+			_ = process.Wait()
+			data, _ := os.ReadFile(logFile.Name())
+			t.Fatalf("crash owner not ready: %s", data)
+		}
+		time.Sleep(time.Millisecond)
+	}
+	if err := process.Process.Kill(); err != nil {
+		t.Fatal(err)
+	}
+	// Do not reap yet. Wait until namespace flock can be reacquired.
+	for deadline := time.Now().Add(time.Second); ; {
+		owner, err := lockSystemRouteJournal(12000)
+		if err == nil {
+			owner.unlock()
+			_, status, statErr := systemRouteProcessStat(process.Process.Pid)
+			// SIGKILL delivery releases files slightly before /proc transitions
+			// to Z. Wait for confirmed death, but deliberately do not reap.
+			if os.IsNotExist(statErr) || statErr == nil && (status == "Z" || status == "X") {
+				break
+			}
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("killed owner retained lock: %v", err)
+		}
+		time.Sleep(time.Millisecond)
+	}
+	return process
+}
+func testSystemRouteJournalCrashOwner(t *testing.T, stage string) {
+	o := journalTestOptions()
+	bypass, err := newSystemRouteBypass(LC.Tun{SystemRouteMark: 17}, o)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if stage == "partial" {
+		plan, err := systemRoutePlan(o, 17)
+		if err != nil {
+			t.Fatal(err)
+		}
+		count := 0
+		for _, rule := range plan {
+			if rule.Priority == o.IPRoute2RuleIndex-1 {
+				continue
+			}
+			if err := netlink.RuleAdd(rule); err != nil {
+				t.Fatal(err)
+			}
+			count++
+			if count == 3 {
+				break
+			}
+		}
+	} else if stage == "plan" || stage == "full" {
+		device, err := tun.New(o)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if stage == "full" {
+			if err := recordSystemRouteOwnedRules(journalTestListener(o, bypass, device)); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+	if err := os.WriteFile(filepath.Join(C.Path.HomeDir(), "ready"), []byte("ready"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	select {}
+}
diff --git a/listener/sing_tun/system_route_journal_rejection_linux_test.go b/listener/sing_tun/system_route_journal_rejection_linux_test.go
new file mode 100644
index 0000000..e002e49
--- /dev/null
+++ b/listener/sing_tun/system_route_journal_rejection_linux_test.go
@@ -0,0 +1,204 @@
+//go:build linux
+
+package sing_tun
+
+import (
+	"encoding/json"
+	"os"
+	"reflect"
+	"testing"
+
+	C "github.com/metacubex/mihomo/constant"
+	LC "github.com/metacubex/mihomo/listener/config"
+	"github.com/sagernet/netlink"
+	"github.com/sagernet/netlink/nl"
+	"golang.org/x/sys/unix"
+)
+
+func testSystemRouteJournalRejections(t *testing.T, baseline []netlink.Rule) {
+	t.Run("live-owner-across-home", func(t *testing.T) {
+		o := journalTestOptions()
+		bypass, err := newSystemRouteBypass(LC.Tun{SystemRouteMark: 17}, o)
+		if err != nil {
+			t.Fatal(err)
+		}
+		home := C.Path.HomeDir()
+		C.SetHomeDir(t.TempDir())
+		duplicate, err := newSystemRouteBypass(LC.Tun{SystemRouteMark: 17}, o)
+		C.SetHomeDir(home)
+		if err == nil {
+			_ = duplicate.Close()
+			t.Fatal("live namespace owner accepted in different home")
+		}
+		if err := bypass.Close(); err != nil {
+			t.Fatal(err)
+		}
+		journalTestAssertClean(t, baseline)
+	})
+	for _, change := range []string{"extra-v6", "action", "protocol", "corrupt", "namespace", "boot"} {
+		t.Run("reject-"+change, func(t *testing.T) {
+			process := journalTestCrash(t, "full")
+			defer process.Wait()
+			paths, err := systemRouteJournalPaths()
+			if err != nil || len(paths) != 1 {
+				t.Fatalf("journal: %v %v", paths, err)
+			}
+			data, err := os.ReadFile(paths[0])
+			if err != nil {
+				t.Fatal(err)
+			}
+			originalData := append([]byte(nil), data...)
+			var state systemRouteJournal
+			if err := json.Unmarshal(data, &state); err != nil {
+				t.Fatal(err)
+			}
+			var undo func()
+			if change == "extra-v6" {
+				rule := netlink.NewRule()
+				rule.Family, rule.Priority, rule.Table = unix.AF_INET6, 12005, 201
+				if err := netlink.RuleAdd(rule); err != nil {
+					t.Fatal(err)
+				}
+				undo = func() {
+					if err := netlink.RuleDel(rule); err != nil {
+						t.Fatal(err)
+					}
+				}
+			} else if change == "action" || change == "protocol" {
+				rules, err := systemRouteKernelRules()
+				if err != nil {
+					t.Fatal(err)
+				}
+				var original systemRouteKernelRule
+				for _, rule := range rules {
+					if rule.family == unix.AF_INET && rule.priority == 12010 {
+						original = rule
+						break
+					}
+				}
+				if original.fingerprint == "" {
+					t.Fatal("NOP missing")
+				}
+				if err := deleteSystemRouteRaw(original); err != nil {
+					t.Fatal(err)
+				}
+				raw := []byte(original.fingerprint)
+				if change == "action" {
+					raw[7] = unix.FR_ACT_BLACKHOLE
+				} else {
+					// FRA_PROTOCOL is kept in canonical identity, never inferred from RuleList.
+					for i := 12; i+4 <= len(raw); {
+						length := int(raw[i]) | int(raw[i+1])<<8
+						key := int(raw[i+2]) | int(raw[i+3])<<8
+						if key == 21 {
+							raw[i+4] = 99
+							break
+						}
+						i += (length + 3) &^ 3
+					}
+				}
+				if err := journalTestAddRaw(raw); err != nil {
+					t.Fatal(err)
+				}
+				changed := original
+				changed.fingerprint = string(raw)
+				undo = func() {
+					if err := deleteSystemRouteRaw(changed); err != nil {
+						t.Fatal(err)
+					}
+					if err := journalTestAddRaw([]byte(original.fingerprint)); err != nil {
+						t.Fatal(err)
+					}
+				}
+			} else {
+				switch change {
+				case "corrupt":
+					data = []byte("invalid")
+				case "namespace":
+					state.Namespace = "other"
+					data, _ = json.Marshal(state)
+				case "boot":
+					state.BootID = "other-boot"
+					data, _ = json.Marshal(state)
+				}
+				if err := os.WriteFile(paths[0], data, 0600); err != nil {
+					t.Fatal(err)
+				}
+				undo = func() {
+					if err := os.WriteFile(paths[0], originalData, 0600); err != nil {
+						t.Fatal(err)
+					}
+				}
+			}
+			before := systemRouteRuleSnapshot(t)
+			rawBefore, err := systemRouteKernelRules()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := CleanupSystemRouteJournal(LC.Tun{}); err == nil {
+				t.Fatal("unsafe recovery accepted")
+			}
+			rawAfter, err := systemRouteKernelRules()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !reflect.DeepEqual(before, systemRouteRuleSnapshot(t)) || !reflect.DeepEqual(rawBefore, rawAfter) {
+				t.Fatal("rejected recovery changed kernel rules")
+			}
+			undo()
+			if err := CleanupSystemRouteJournal(LC.Tun{}); err != nil {
+				t.Fatal(err)
+			}
+			journalTestAssertClean(t, baseline)
+		})
+	}
+	t.Run("single-family-cold-hot-other-family", func(t *testing.T) {
+		o := journalTestOptions()
+		o.Inet6Address = nil
+		user := netlink.NewRule()
+		user.Family, user.Priority, user.Table = unix.AF_INET6, 12005, 201
+		if err := netlink.RuleAdd(user); err != nil {
+			t.Fatal(err)
+		}
+		before := systemRouteRuleSnapshot(t)
+		if bypass, err := newSystemRouteBypass(LC.Tun{SystemRouteMark: 17}, o); err == nil {
+			_ = bypass.Close()
+			t.Fatal("v4 startup accepted owned-window IPv6 rule")
+		}
+		if !reflect.DeepEqual(before, systemRouteRuleSnapshot(t)) {
+			t.Fatal("cold reject changed IPv6 user rule")
+		}
+		if err := netlink.RuleDel(user); err != nil {
+			t.Fatal(err)
+		}
+		active := journalTestOpen(t, o)
+		if err := netlink.RuleAdd(user); err != nil {
+			t.Fatal(err)
+		}
+		before = systemRouteRuleSnapshot(t)
+		replacement := active.options
+		replacement.IPRoute2RuleIndex = 13000
+		if err := active.CheckSystemRouteReplacement(replacement); err == nil {
+			t.Fatal("changed-index reload accepted old-window IPv6 rule")
+		}
+		replacement.Enable = false
+		if err := active.CheckSystemRouteReplacement(replacement); err == nil {
+			t.Fatal("disable accepted old-window IPv6 rule")
+		}
+		if !reflect.DeepEqual(before, systemRouteRuleSnapshot(t)) {
+			t.Fatal("hot reject changed IPv6 user rule")
+		}
+		if err := netlink.RuleDel(user); err != nil {
+			t.Fatal(err)
+		}
+		journalTestClose(t, active)
+		journalTestAssertClean(t, baseline)
+	})
+}
+
+func journalTestAddRaw(raw []byte) error {
+	req := nl.NewNetlinkRequest(unix.RTM_NEWRULE, unix.NLM_F_CREATE|unix.NLM_F_EXCL|unix.NLM_F_ACK)
+	req.AddData(systemRouteRawMessage(raw))
+	_, err := req.Execute(unix.NETLINK_ROUTE, 0)
+	return err
+}
diff --git a/listener/sing_tun/system_route_linux.go b/listener/sing_tun/system_route_linux.go
new file mode 100644
index 0000000..459b028
--- /dev/null
+++ b/listener/sing_tun/system_route_linux.go
@@ -0,0 +1,181 @@
+//go:build linux
+
+package sing_tun
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"sync"
+
+	LC "github.com/metacubex/mihomo/listener/config"
+	tun "github.com/metacubex/sing-tun"
+	"github.com/sagernet/netlink"
+	"golang.org/x/sys/unix"
+)
+
+// sing-tun v0.4.28's NativeTun.rules reserves [IPRoute2RuleIndex,
+// IPRoute2RuleIndex+10], including its final no-op rule. Its unsetRules uses
+// exactly the same interval. Keep this boundary in sync when updating that
+// dependency; the integration test creates a real TUN and checks its rules.
+// Jump to its final no-op rule, so user policy rules after it still apply.
+// The target must exist: Linux leaves a goto to an absent priority unresolved.
+
+type systemRouteBypass struct {
+	mu      sync.Mutex
+	rules   []*netlink.Rule
+	journal *systemRouteJournalOwner
+}
+
+func newSystemRouteBypass(options LC.Tun, tunOptions tun.Options) (io.Closer, error) {
+	if options.SystemRouteMark == 0 {
+		return nil, cleanupSystemRouteJournal(options)
+	}
+	if !tunOptions.AutoRoute || options.AutoRedirect || options.FileDescriptor != 0 {
+		return nil, errors.New("system-route-mark requires auto-route without auto-redirect or file-descriptor")
+	}
+	start := tunOptions.IPRoute2RuleIndex
+	if start <= 1 || start > 32765-systemRouteRuleWindow {
+		return nil, errors.New("system-route-mark requires a rule index between 2 and 32755")
+	}
+	plan, err := systemRoutePlan(tunOptions, options.SystemRouteMark)
+	if err != nil {
+		return nil, err
+	}
+	if len(plan) == 0 {
+		return nil, cleanupSystemRouteJournal(options)
+	}
+	owner, err := prepareSystemRouteJournal(tunOptions, plan)
+	if err != nil {
+		return nil, err
+	}
+	bypass := &systemRouteBypass{journal: owner}
+	families := make([]int, 0, 2)
+	if len(tunOptions.Inet4Address) > 0 {
+		families = append(families, unix.AF_INET)
+	}
+	if len(tunOptions.Inet6Address) > 0 {
+		families = append(families, unix.AF_INET6)
+	}
+	for _, family := range families {
+		rule := netlink.NewRule()
+		rule.Family = family
+		rule.Priority = start - 1
+		rule.Mark = options.SystemRouteMark
+		rule.MarkSet = true
+		exactMask := ^uint32(0)
+		rule.Mask = int(exactMask) // -1 on 32-bit: the kernel's exact default mask.
+		rule.Goto = start + systemRouteRuleWindow
+		if err := netlink.RuleAdd(rule); err != nil {
+			return nil, errors.Join(err, bypass.Close())
+		}
+		bypass.rules = append(bypass.rules, rule)
+	}
+	return bypass, nil
+}
+
+func checkSystemRouteRules(rules []netlink.Rule, start int) error {
+	for _, rule := range rules {
+		if rule.Priority >= start-1 && rule.Priority <= start+systemRouteRuleWindow {
+			return fmt.Errorf("routing rule priority %d is already in use", rule.Priority)
+		}
+	}
+	return nil
+}
+
+func recordSystemRouteOwnedRules(l *Listener) error {
+	if !l.options.AutoRoute || l.options.AutoRedirect || l.options.FileDescriptor != 0 {
+		return nil
+	}
+	start := l.options.IPRoute2RuleIndex
+	if start == 0 {
+		start = tun.DefaultIPRoute2RuleIndex
+	}
+	rules, err := systemRouteKernelRules()
+	if err != nil {
+		if l.options.SystemRouteMark != 0 {
+			return err
+		}
+		return nil
+	}
+	owned := make([]systemRouteKernelRule, 0)
+	for _, rule := range rules {
+		if (rule.family == unix.AF_INET || rule.family == unix.AF_INET6) &&
+			(rule.priority >= start && rule.priority <= start+systemRouteRuleWindow ||
+				(l.options.SystemRouteMark != 0 && rule.priority == start-1)) {
+			owned = append(owned, rule)
+		}
+	}
+	l.systemRouteOwnedRules = owned
+	if bypass, ok := l.systemRouteBypass.(*systemRouteBypass); ok {
+		return bypass.finishJournal(owned)
+	}
+	return nil
+}
+
+// CheckSystemRouteReplacement runs before the old listener is closed. Ignore
+// only its exact kernel-rule snapshot, so external modifications or a new
+// conflicting user rule fail without disrupting the existing listener.
+func (l *Listener) CheckSystemRouteReplacement(options LC.Tun) error {
+	if options.SystemRouteMark == 0 && l.options.SystemRouteMark == 0 {
+		return nil
+	}
+	if options.Enable && options.SystemRouteMark != 0 && (!options.AutoRoute || options.AutoRedirect || options.FileDescriptor != 0) {
+		return errors.New("system-route-mark requires auto-route without auto-redirect or file-descriptor")
+	}
+	start := options.IPRoute2RuleIndex
+	if start == 0 {
+		start = tun.DefaultIPRoute2RuleIndex
+	}
+	if start <= 1 || start > 32765-systemRouteRuleWindow {
+		return errors.New("system-route-mark requires a rule index between 2 and 32755")
+	}
+	rules, err := systemRouteKernelRules()
+	if err != nil {
+		return err
+	}
+	oldStart := l.options.IPRoute2RuleIndex
+	if oldStart == 0 {
+		oldStart = tun.DefaultIPRoute2RuleIndex
+	}
+	owned, _ := l.systemRouteOwnedRules.([]systemRouteKernelRule)
+	remaining := make(map[systemRouteKernelRule]int, len(owned))
+	for _, rule := range owned {
+		remaining[rule]++
+	}
+	for _, rule := range rules {
+		if remaining[rule] > 0 {
+			remaining[rule]--
+			continue
+		}
+		if (rule.family == unix.AF_INET || rule.family == unix.AF_INET6) &&
+			((rule.priority >= start-1 && rule.priority <= start+systemRouteRuleWindow) ||
+				(rule.priority >= oldStart-1 && rule.priority <= oldStart+systemRouteRuleWindow)) {
+			return fmt.Errorf("routing rule priority %d is already in use", rule.priority)
+		}
+	}
+	return nil
+}
+
+func (b *systemRouteBypass) Close() error {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.journal != nil {
+		err := b.journal.recover(&b.journal.state)
+		err = errors.Join(err, b.journal.unlock())
+		b.journal = nil
+		b.rules = nil
+		return err
+	}
+	var errs []error
+	remaining := b.rules[:0]
+	for _, rule := range b.rules {
+		// Delete the full selector we added, never a priority-only match.
+		if err := netlink.RuleDel(rule); err != nil && !errors.Is(err, unix.ENOENT) && !errors.Is(err, unix.ESRCH) {
+			errs = append(errs, err)
+			remaining = append(remaining, rule)
+		}
+	}
+	b.rules = remaining
+	return errors.Join(errs...)
+}
diff --git a/listener/sing_tun/system_route_linux_test.go b/listener/sing_tun/system_route_linux_test.go
new file mode 100644
index 0000000..7d56fb4
--- /dev/null
+++ b/listener/sing_tun/system_route_linux_test.go
@@ -0,0 +1,67 @@
+//go:build linux
+
+package sing_tun
+
+import (
+	"testing"
+
+	LC "github.com/metacubex/mihomo/listener/config"
+	tun "github.com/metacubex/sing-tun"
+	"github.com/sagernet/netlink"
+)
+
+func TestSystemRouteRuleConflicts(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		rule func() netlink.Rule
+		want bool
+	}{
+		{"ordinary-main", func() netlink.Rule { r := netlink.NewRule(); r.Priority = 32766; r.Table = 254; return *r }, false},
+		{"later-user-policy", func() netlink.Rule { r := netlink.NewRule(); r.Priority = 12000; r.Table = 201; return *r }, false},
+		{"same-mark", func() netlink.Rule { r := netlink.NewRule(); r.Priority = 100; r.Mark = 17; return *r }, false},
+		{"overlap-mask", func() netlink.Rule { r := netlink.NewRule(); r.Priority = 100; r.Mark = 16; r.Mask = 0xf0; return *r }, false},
+		{"other-mark", func() netlink.Rule { r := netlink.NewRule(); r.Priority = 100; r.Mark = 1; return *r }, false},
+		{"zero-mark-mask", func() netlink.Rule { r := netlink.NewRule(); r.Priority = 100; r.Mask = 0xf0; return *r }, false},
+		{"inverted-mark", func() netlink.Rule { r := netlink.NewRule(); r.Priority = 100; r.Mark = 1; r.Invert = true; return *r }, false},
+		{"bypass-priority", func() netlink.Rule { r := netlink.NewRule(); r.Priority = 8999; return *r }, true},
+		{"tun-priority", func() netlink.Rule { r := netlink.NewRule(); r.Priority = 9005; return *r }, true},
+		{"last-tun-priority", func() netlink.Rule { r := netlink.NewRule(); r.Priority = 9010; return *r }, true},
+		{"first-later-priority", func() netlink.Rule { r := netlink.NewRule(); r.Priority = 9011; return *r }, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			err := checkSystemRouteRules([]netlink.Rule{tc.rule()}, 9000)
+			if (err != nil) != tc.want {
+				t.Fatalf("checkSystemRouteRules error = %v, want conflict = %v", err, tc.want)
+			}
+		})
+	}
+}
+
+func TestSystemRouteOptionsValidation(t *testing.T) {
+	if closer, err := newSystemRouteBypass(LC.Tun{}, tun.Options{}); err != nil || closer != nil {
+		t.Fatalf("disabled feature changed behavior: %v %v", closer, err)
+	}
+	for _, tc := range []struct {
+		name string
+		raw  LC.Tun
+		tun  tun.Options
+	}{
+		{"no-auto-route", LC.Tun{SystemRouteMark: 17}, tun.Options{IPRoute2RuleIndex: 9000}},
+		{"auto-redirect", LC.Tun{SystemRouteMark: 17, AutoRedirect: true}, tun.Options{AutoRoute: true, IPRoute2RuleIndex: 9000}},
+		{"borrowed-fd", LC.Tun{SystemRouteMark: 17, FileDescriptor: 1}, tun.Options{AutoRoute: true, IPRoute2RuleIndex: 9000}},
+		{"too-low", LC.Tun{SystemRouteMark: 17}, tun.Options{AutoRoute: true, IPRoute2RuleIndex: 1}},
+		{"too-high", LC.Tun{SystemRouteMark: 17}, tun.Options{AutoRoute: true, IPRoute2RuleIndex: 32756}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if _, err := newSystemRouteBypass(tc.raw, tc.tun); err == nil {
+				t.Fatal("unsafe combination accepted")
+			}
+		})
+	}
+	base := LC.Tun{}
+	changed := base
+	changed.SystemRouteMark = 17
+	if base.Equal(changed) || changed.Equal(base) {
+		t.Fatal("changing system-route-mark did not trigger TUN recreation")
+	}
+}
diff --git a/listener/sing_tun/system_route_namespace_linux_test.go b/listener/sing_tun/system_route_namespace_linux_test.go
