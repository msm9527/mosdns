+//go:build !linux
+
+package sing_tun
+
+import (
+	"errors"
+	"io"
+
+	LC "github.com/metacubex/mihomo/listener/config"
+	tun "github.com/metacubex/sing-tun"
+)
+
+// ValidateSystemRouteOptions rejects unsupported marked TUN configurations
+// during cold -t preflight, before a manager stops any running core.
+func ValidateSystemRouteOptions(options LC.Tun) error {
+	if options.Enable && options.SystemRouteMark != 0 {
+		return errors.New("system-route-mark is only supported on Linux")
+	}
+	return nil
+}
+
+func newSystemRouteBypass(options LC.Tun, _ tun.Options) (io.Closer, error) {
+	if options.SystemRouteMark != 0 {
+		return nil, errors.New("system-route-mark is only supported on Linux")
+	}
+	return nil, nil
+}
+
+func recordSystemRouteOwnedRules(_ *Listener) error { return nil }
+
+func (l *Listener) CheckSystemRouteReplacement(options LC.Tun) error {
+	return ValidateSystemRouteOptions(options)
+}
+
+func CleanupSystemRouteJournal(_ LC.Tun) error { return nil }
diff --git a/listener/sing_tun/system_route_plan_linux.go b/listener/sing_tun/system_route_plan_linux.go
new file mode 100644
index 0000000..375b23e
--- /dev/null
+++ b/listener/sing_tun/system_route_plan_linux.go
@@ -0,0 +1,166 @@
+//go:build linux
+
+package sing_tun
+
+import (
+	"fmt"
+	"net/netip"
+
+	tun "github.com/metacubex/sing-tun"
+	"github.com/sagernet/netlink"
+	"golang.org/x/sys/unix"
+)
+
+// A write-ahead plan for the supported Linux auto-route branch of pinned
+// sing-tun v0.4.28 NativeTun.rules. The namespace gate compares this plan with
+// the actual kernel rules, including every selector/action/protocol, so a
+// dependency change cannot silently broaden recovery ownership.
+func systemRoutePlan(o tun.Options, mark uint32) ([]*netlink.Rule, error) {
+	if !o.AutoRoute || o.AutoRedirectMarkMode || o.FileDescriptor != 0 {
+		return nil, fmt.Errorf("unsupported system-route rule plan")
+	}
+	var rules []*netlink.Rule
+	families := []int{}
+	if len(o.Inet4Address) > 0 {
+		families = append(families, unix.AF_INET)
+	}
+	if len(o.Inet6Address) > 0 {
+		families = append(families, unix.AF_INET6)
+	}
+	if len(families) == 0 {
+		return nil, nil
+	}
+	for _, family := range families {
+		p := o.IPRoute2RuleIndex
+		nop := p + systemRouteRuleWindow
+		add := func() *netlink.Rule {
+			r := netlink.NewRule()
+			r.Family = family
+			r.Priority = p
+			rules = append(rules, r)
+			return r
+		}
+		r := add()
+		r.Priority = p - 1
+		r.Mark = mark
+		r.MarkSet = true
+		exactMask := ^uint32(0)
+		r.Mask = int(exactMask)
+		r.Goto = nop
+		for _, port := range o.ExcludeSrcPort {
+			r := add()
+			r.Sport = netlink.NewRulePortRange(port.Start, port.End)
+			r.Goto = nop
+		}
+		for _, port := range o.ExcludeDstPort {
+			r := add()
+			r.Dport = netlink.NewRulePortRange(port.Start, port.End)
+			r.Goto = nop
+		}
+		excluded := o.ExcludedRanges()
+		for _, ids := range excluded {
+			r := add()
+			r.UIDRange = netlink.NewRuleUIDRange(ids.Start, ids.End)
+			r.Goto = nop
+		}
+		if len(o.ExcludeSrcPort)+len(o.ExcludeDstPort)+len(excluded) > 0 {
+			p++
+		}
+		if len(o.IncludeInterface) > 0 {
+			matched := p + 2
+			// Pinned upstream computes the common include target from IPv4
+			// priority, even in IPv6-only configurations. Preserve that plan.
+			if len(o.Inet4Address) == 0 {
+				matched = o.IPRoute2RuleIndex + 2
+			}
+			for _, iface := range o.IncludeInterface {
+				r := add()
+				r.IifName = iface
+				r.Goto = matched
+			}
+			p++
+			r := add()
+			r.Goto = nop
+			p++
+			r = add()
+			r.Priority = matched
+			p++
+		} else if len(o.ExcludeInterface) > 0 {
+			for _, iface := range o.ExcludeInterface {
+				r := add()
+				r.IifName = iface
+				r.Goto = nop
+			}
+			p++
+		}
+		if family == unix.AF_INET {
+			for _, address := range o.Inet4Address {
+				r := add()
+				r.Dst = address.Masked()
+				r.Table = o.IPRoute2TableIndex
+			}
+			p++
+		}
+		r = add()
+		r.Invert = true
+		r.Dport = netlink.NewRulePortRange(53, 53)
+		r.Table = unix.RT_TABLE_MAIN
+		r.SuppressPrefixlen = 0
+		r = add()
+		r.IifName = o.Name
+		r.Goto = nop
+		if family == unix.AF_INET {
+			p++
+			r = add()
+			r.Invert = true
+			r.IifName = "lo"
+			r.Table = o.IPRoute2TableIndex
+			r = add()
+			r.IifName = "lo"
+			r.Src = netip.PrefixFrom(netip.IPv4Unspecified(), 32)
+			r.Table = o.IPRoute2TableIndex
+			for _, address := range o.Inet4Address {
+				r := add()
+				r.IifName = "lo"
+				r.Src = address.Masked()
+				r.Table = o.IPRoute2TableIndex
+			}
+		} else {
+			for _, address := range []netip.Prefix{netip.MustParsePrefix("::/1"), netip.MustParsePrefix("8000::/1")} {
+				r := add()
+				r.IifName = "lo"
+				r.Src = address
+				r.Goto = nop
+			}
+			p++
+			for _, address := range o.Inet6Address {
+				r := add()
+				r.IifName = "lo"
+				r.Src = address.Masked()
+				r.Table = o.IPRoute2TableIndex
+			}
+			p++
+			r = add()
+			r.Table = o.IPRoute2TableIndex
+		}
+		p = nop
+		add()
+	}
+	if o.StrictRoute {
+		for _, family := range []int{unix.AF_INET, unix.AF_INET6} {
+			if (family == unix.AF_INET && len(o.Inet4Address) == 0) || (family == unix.AF_INET6 && len(o.Inet6Address) == 0) {
+				r := netlink.NewRule()
+				r.Family = family
+				r.Priority = o.IPRoute2RuleIndex
+				r.Type = unix.FR_ACT_UNREACHABLE
+				rules = append(rules, r)
+			}
+		}
+	}
+	for _, r := range rules {
+		if r.Priority < o.IPRoute2RuleIndex-1 || r.Priority > o.IPRoute2RuleIndex+systemRouteRuleWindow {
+			return nil, fmt.Errorf("rule plan exceeds reserved priority window")
+		}
+	}
+	return rules, nil
+}
diff --git a/listener/sing_tun/system_route_recovery_linux.go b/listener/sing_tun/system_route_recovery_linux.go
new file mode 100644
index 0000000..aef70de
--- /dev/null
+++ b/listener/sing_tun/system_route_recovery_linux.go
@@ -0,0 +1,235 @@
+//go:build linux
+
+package sing_tun
+
+import (
+	"errors"
+	"fmt"
+	C "github.com/metacubex/mihomo/constant"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+
+	LC "github.com/metacubex/mihomo/listener/config"
+	tun "github.com/metacubex/sing-tun"
+	"github.com/sagernet/netlink"
+	"golang.org/x/sys/unix"
+)
+
+func systemRouteJournalWindow(rules []systemRouteKernelRule, index int) []systemRouteKernelRule {
+	var result []systemRouteKernelRule
+	for _, rule := range rules {
+		if (rule.family == unix.AF_INET || rule.family == unix.AF_INET6) && rule.priority >= index-1 && rule.priority <= index+systemRouteRuleWindow {
+			result = append(result, rule)
+		}
+	}
+	return result
+}
+
+func validateSystemRouteJournalRules(state *systemRouteJournal, current []systemRouteKernelRule, complete bool) error {
+	remaining := make(map[string]int)
+	for _, rule := range state.Rules {
+		if rule.Family != unix.AF_INET && rule.Family != unix.AF_INET6 || rule.Priority < state.Index-1 || rule.Priority > state.Index+systemRouteRuleWindow || rule.Identity == "" {
+			return errors.New("invalid system-route journal rule")
+		}
+		if state.Complete {
+			identity, err := systemRouteIdentityFromRaw(string(rule.Raw))
+			if err != nil || identity != rule.Identity {
+				return errors.New("corrupt system-route journal fingerprint")
+			}
+		}
+		remaining[rule.Identity]++
+	}
+	for _, rule := range systemRouteJournalWindow(current, state.Index) {
+		identity, err := systemRouteIdentityFromRaw(rule.fingerprint)
+		if err != nil {
+			return err
+		}
+		if remaining[identity] == 0 {
+			return fmt.Errorf("unowned or changed routing rule priority %d; existing rules retained", rule.priority)
+		}
+		remaining[identity]--
+	}
+	if complete {
+		for _, count := range remaining {
+			if count != 0 {
+				return errors.New("kernel routing rules differ from the pinned sing-tun write-ahead plan")
+			}
+		}
+	}
+	return nil
+}
+
+func (o *systemRouteJournalOwner) recover(state *systemRouteJournal) error {
+	current, err := systemRouteKernelRules()
+	if err != nil {
+		return err
+	}
+	if state.BootID != o.state.BootID {
+		if len(systemRouteJournalWindow(current, state.Index)) > 0 {
+			return errors.New("new boot has unowned routing rules; existing rules retained")
+		}
+		return o.remove()
+	}
+	if err = validateSystemRouteJournalRules(state, current, false); err != nil {
+		return err
+	}
+	// Validation of the entire window precedes the first deletion. Delete each
+	// full raw kernel message, never by priority. Missing owned rules are safe:
+	// recovery itself may have been interrupted between individual deletions.
+	for _, rule := range systemRouteJournalWindow(current, state.Index) {
+		if err = deleteSystemRouteRaw(rule); err != nil && !errors.Is(err, unix.ENOENT) && !errors.Is(err, unix.ESRCH) {
+			return err
+		}
+	}
+	return o.remove()
+}
+
+// Scan only this data directory and network namespace. Other directories'
+// journal-enabled instances remain protected by the namespace-wide lock.
+func systemRouteJournalPaths() ([]string, error) {
+	var stat unix.Stat_t
+	if err := unix.Stat("/proc/self/ns/net", &stat); err != nil {
+		return nil, err
+	}
+	namespace := strconv.FormatUint(uint64(stat.Dev), 10) + "-" + strconv.FormatUint(stat.Ino, 10)
+	entries, err := os.ReadDir(C.Path.HomeDir())
+	if errors.Is(err, os.ErrNotExist) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	prefix := ".system-route-" + namespace + "-"
+	var paths []string
+	for _, entry := range entries {
+		if strings.HasPrefix(entry.Name(), prefix) && strings.HasSuffix(entry.Name(), ".json") {
+			paths = append(paths, filepath.Join(C.Path.HomeDir(), entry.Name()))
+		}
+	}
+	return paths, nil
+}
+
+func recoverSystemRouteJournals(owner *systemRouteJournalOwner) error {
+	paths, err := systemRouteJournalPaths()
+	if err != nil {
+		return err
+	}
+	type recovery struct {
+		owner systemRouteJournalOwner
+		state *systemRouteJournal
+	}
+	var pending []recovery
+	current, err := systemRouteKernelRules()
+	if err != nil {
+		return err
+	}
+	for _, path := range paths {
+		prefix := ".system-route-" + owner.state.Namespace + "-"
+		index, err := strconv.Atoi(strings.TrimSuffix(strings.TrimPrefix(filepath.Base(path), prefix), ".json"))
+		if err != nil {
+			return errors.New("invalid system-route journal filename")
+		}
+		previous := *owner
+		previous.path, previous.state.Index = path, index
+		state, err := previous.read()
+		if err != nil {
+			return err
+		}
+		if state == nil {
+			continue
+		}
+		if state.BootID != owner.state.BootID {
+			if len(systemRouteJournalWindow(current, state.Index)) > 0 {
+				return errors.New("new boot has unowned routing rules; existing rules retained")
+			}
+		} else if err = validateSystemRouteJournalRules(state, current, false); err != nil {
+			return err
+		}
+		pending = append(pending, recovery{previous, state})
+	}
+	// Every journal is validated before recovering any window.
+	for _, item := range pending {
+		if err := item.owner.recover(item.state); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func prepareSystemRouteJournal(o tun.Options, plan []*netlink.Rule) (*systemRouteJournalOwner, error) {
+	owner, err := lockSystemRouteJournal(o.IPRoute2RuleIndex)
+	if err != nil {
+		return nil, err
+	}
+	fail := func(err error) (*systemRouteJournalOwner, error) { owner.unlock(); return nil, err }
+	if err = recoverSystemRouteJournals(owner); err != nil {
+		return fail(err)
+	}
+	current, err := systemRouteKernelRules()
+	if err != nil {
+		return fail(err)
+	}
+	if window := systemRouteJournalWindow(current, o.IPRoute2RuleIndex); len(window) > 0 {
+		return fail(fmt.Errorf("routing rule priority %d is already in use", window[0].priority))
+	}
+	owner.state.Device = o.Name
+	for _, rule := range plan {
+		identity, err := systemRouteIdentityFromPlan(rule)
+		if err != nil {
+			return fail(err)
+		}
+		owner.state.Rules = append(owner.state.Rules, systemRouteJournalRule{Family: rule.Family, Priority: rule.Priority, Identity: identity})
+	}
+	if err = owner.write(); err != nil {
+		return fail(err)
+	}
+	return owner, nil
+}
+
+func (b *systemRouteBypass) finishJournal(owned []systemRouteKernelRule) error {
+	if b.journal == nil {
+		return nil
+	}
+	if err := validateSystemRouteJournalRules(&b.journal.state, owned, true); err != nil {
+		return err
+	}
+	rules := make([]systemRouteJournalRule, 0, len(owned))
+	for _, rule := range owned {
+		identity, err := systemRouteIdentityFromRaw(rule.fingerprint)
+		if err != nil {
+			return err
+		}
+		rules = append(rules, systemRouteJournalRule{Family: rule.family, Priority: rule.priority, Identity: identity, Raw: []byte(rule.fingerprint)})
+	}
+	b.journal.state.Rules = rules
+	b.journal.state.Complete = true
+	return b.journal.write()
+}
+
+func cleanupSystemRouteJournal(options LC.Tun) error {
+	// Ordinary configurations without recovery state acquire no lock, read no
+	// boot/PID metadata and create no directory or journal.
+	paths, err := systemRouteJournalPaths()
+	if err != nil {
+		return err
+	}
+	if len(paths) == 0 {
+		return nil
+	}
+	index := options.IPRoute2RuleIndex
+	if index == 0 {
+		index = tun.DefaultIPRoute2RuleIndex
+	}
+	owner, err := lockSystemRouteJournal(index)
+	if err != nil {
+		return err
+	}
+	defer owner.unlock()
+	return recoverSystemRouteJournals(owner)
+}
+
+// CleanupSystemRouteJournal is used only when a fresh process disables TUN.
+// It removes verified crash residue while leaving all unjournaled rules alone.
+func CleanupSystemRouteJournal(options LC.Tun) error { return cleanupSystemRouteJournal(options) }
