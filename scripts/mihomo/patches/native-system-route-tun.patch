index 0000000..c8f78d2
--- /dev/null
+++ b/listener/sing_tun/system_route_namespace_linux_test.go
@@ -0,0 +1,313 @@
+//go:build linux
+
+package sing_tun
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"net"
+	"net/netip"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+
+	LC "github.com/metacubex/mihomo/listener/config"
+	tun "github.com/metacubex/sing-tun"
+	"github.com/sagernet/netlink"
+	"golang.org/x/sys/unix"
+)
+
+func TestSystemRouteBypassNamespace(t *testing.T) {
+	if os.Getenv("MIHOMO_SYSTEM_ROUTE_CHILD") == "1" {
+		testSystemRoutePackets(t)
+		return
+	}
+	if os.Getenv("MIHOMO_TUN_RULES_INTEGRATION") != "1" {
+		t.Skip("set MIHOMO_TUN_RULES_INTEGRATION=1 in an isolated CAP_NET_ADMIN/CAP_SYS_ADMIN container")
+	}
+	if os.Geteuid() != 0 {
+		t.Fatal("namespace integration requires root")
+	}
+	mainNS, peerNS := fmt.Sprintf("msm-sys-%d", os.Getpid()), fmt.Sprintf("msm-peer-%d", os.Getpid())
+	command := func(args ...string) {
+		t.Helper()
+		if out, err := exec.Command(args[0], args[1:]...).CombinedOutput(); err != nil {
+			t.Fatalf("%v: %v: %s", args, err, out)
+		}
+	}
+	for _, ns := range []string{mainNS, peerNS} {
+		command("ip", "netns", "add", ns)
+		ns := ns
+		t.Cleanup(func() { _ = exec.Command("ip", "netns", "del", ns).Run() })
+		command("ip", "-n", ns, "link", "set", "lo", "up")
+		command("ip", "netns", "exec", ns, "sysctl", "-qw", "net.ipv4.conf.all.rp_filter=0", "net.ipv4.conf.default.rp_filter=0")
+	}
+	command("ip", "-n", mainNS, "link", "add", "sysroute0", "type", "veth", "peer", "name", "sysroute1")
+	command("ip", "-n", mainNS, "link", "set", "sysroute1", "netns", peerNS)
+	for _, endpoint := range []struct{ ns, dev, v4, v6 string }{
+		{mainNS, "sysroute0", "10.70.0.1/24", "fd70::1/64"},
+		{peerNS, "sysroute1", "10.70.0.2/24", "fd70::2/64"},
+	} {
+		command("ip", "-n", endpoint.ns, "addr", "add", endpoint.v4, "dev", endpoint.dev)
+		command("ip", "-n", endpoint.ns, "addr", "add", endpoint.v6, "dev", endpoint.dev, "nodad")
+		command("ip", "-n", endpoint.ns, "link", "set", endpoint.dev, "up")
+	}
+	command("ip", "-n", peerNS, "addr", "add", "203.0.113.10/32", "dev", "lo")
+	command("ip", "-n", peerNS, "addr", "add", "2001:db8:70::10/128", "dev", "lo", "nodad")
+	// A dead main default makes the later user policy necessary to reach the
+	// peer; forcing marked traffic straight to main would fail this test.
+	command("ip", "-n", mainNS, "route", "add", "default", "via", "10.70.0.254")
+	command("ip", "-n", mainNS, "-6", "route", "add", "default", "via", "fd70::fe")
+	for _, family := range []struct{ flag, destination, gateway string }{
+		{"-4", "203.0.113.10/32", "10.70.0.2"},
+		{"-6", "2001:db8:70::10/128", "fd70::2"},
+	} {
+		command("ip", "-n", mainNS, family.flag, "route", "add", "table", "201", family.destination, "via", family.gateway, "dev", "sysroute0")
+		command("ip", "-n", mainNS, family.flag, "rule", "add", "priority", "10020", "fwmark", "17", "to", family.destination, "lookup", "201")
+	}
+	peerCode := `import pathlib, socket, sys, threading, time
+def echo(s):
+ while True:
+  data,peer=s.recvfrom(2048);s.sendto(data,peer)
+for family,address in [(socket.AF_INET,'203.0.113.10'),(socket.AF_INET6,'2001:db8:70::10')]:
+ s=socket.socket(family,socket.SOCK_DGRAM)
+ if family==socket.AF_INET6:s.setsockopt(socket.IPPROTO_IPV6,socket.IPV6_V6ONLY,1)
+ s.bind((address,19090))
+ threading.Thread(target=echo,args=(s,),daemon=True).start()
+pathlib.Path(sys.argv[1]).write_text('ready')
+time.sleep(60)
+`
+	readyPath := filepath.Join(t.TempDir(), "peer-ready")
+	peer := exec.Command("ip", "netns", "exec", peerNS, "python3", "-c", peerCode, readyPath)
+	var peerLog bytes.Buffer
+	peer.Stdout, peer.Stderr = &peerLog, &peerLog
+	if err := peer.Start(); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = peer.Process.Kill(); _ = peer.Wait() })
+	for deadline := time.Now().Add(3 * time.Second); ; {
+		if _, err := os.Stat(readyPath); err == nil {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("UDP peer did not become ready")
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	executable, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	child := exec.Command("ip", "netns", "exec", mainNS, executable, "-test.run=^TestSystemRouteBypassNamespace$", "-test.v", "-test.timeout=30s")
+	child.Env = append(os.Environ(), "MIHOMO_SYSTEM_ROUTE_CHILD=1")
+	if out, err := child.CombinedOutput(); err != nil {
+		t.Fatalf("namespace test: %v\n%s\npeer: %s", err, out, peerLog.String())
+	} else {
+		t.Log(string(out))
+	}
+}
+
+func testSystemRoutePackets(t *testing.T) {
+	const start = 10000
+	options := tun.Options{
+		Name: "system_route", MTU: 1500, AutoRoute: true,
+		IPRoute2TableIndex: 2022, IPRoute2RuleIndex: start,
+		Inet4Address:      []netip.Prefix{netip.MustParsePrefix("198.18.0.1/30")},
+		Inet6Address:      []netip.Prefix{netip.MustParsePrefix("fdfe:abcd::1/126")},
+		Inet4RouteAddress: []netip.Prefix{netip.MustParsePrefix("203.0.113.10/32")},
+		Inet6RouteAddress: []netip.Prefix{netip.MustParsePrefix("2001:db8:70::10/128")},
+	}
+	baseline := systemRouteRuleSnapshot(t)
+	for iteration := 0; iteration < 3; iteration++ {
+		bypass, err := newSystemRouteBypass(LC.Tun{SystemRouteMark: 17}, options)
+		if err != nil {
+			t.Fatal(err)
+		}
+		// A second owner cannot reuse or delete the first owner's rules.
+		if duplicate, err := newSystemRouteBypass(LC.Tun{SystemRouteMark: 17}, options); err == nil {
+			_ = duplicate.Close()
+			t.Fatal("duplicate mark owner accepted")
+		}
+		device, err := tun.New(options)
+		if err != nil {
+			_ = bypass.Close()
+			t.Fatal(err)
+		}
+		activeOptions := LC.Tun{Enable: true, AutoRoute: true, SystemRouteMark: 17, IPRoute2RuleIndex: start,
+			Inet4Address: options.Inet4Address, Inet6Address: options.Inet6Address}
+		active := &Listener{options: activeOptions, tunIf: device, systemRouteBypass: bypass}
+		if err := recordSystemRouteOwnedRules(active); err != nil {
+			t.Fatal(err)
+		}
+		if err := active.CheckSystemRouteReplacement(activeOptions); err != nil {
+			t.Fatal("own rules incorrectly rejected on hot reload:", err)
+		}
+		conflict := netlink.NewRule()
+		conflict.Family, conflict.Priority, conflict.Table = unix.AF_INET, start+5, 201
+		if err := netlink.RuleAdd(conflict); err != nil {
+			t.Fatal(err)
+		}
+		before := systemRouteRuleSnapshot(t)
+		if err := active.CheckSystemRouteReplacement(activeOptions); err == nil {
+			t.Fatal("hot reload preflight accepted conflicting user rule")
+		}
+		if after := systemRouteRuleSnapshot(t); !reflect.DeepEqual(before, after) {
+			t.Fatal("hot reload preflight disrupted active rules")
+		}
+		if err := netlink.RuleDel(conflict); err != nil {
+			t.Fatal(err)
+		}
+		for _, family := range []int{unix.AF_INET, unix.AF_INET6} {
+			rules, err := netlink.RuleList(family)
+			if err != nil {
+				t.Fatal(err)
+			}
+			foundLast, foundBypass := false, false
+			for _, rule := range rules {
+				if rule.Priority == start+systemRouteRuleWindow {
+					foundLast = true
+				}
+				if rule.Priority == start-1 && rule.Mark == 17 && uint32(rule.Mask) == ^uint32(0) && rule.Goto == start+systemRouteRuleWindow {
+					foundBypass = true
+				}
+				if rule.Table == options.IPRoute2TableIndex && (rule.Priority < start || rule.Priority > start+systemRouteRuleWindow) {
+					t.Fatalf("sing-tun dependency changed rule window: %#v", rule)
+				}
+			}
+			if !foundLast || !foundBypass {
+				t.Fatalf("missing sing-tun boundary or exact bypass rule: %#v", rules)
+			}
+		}
+		captured := make(chan netip.Addr, 16)
+		go func() {
+			packet := make([]byte, 2048)
+			for {
+				n, err := device.Read(packet)
+				if err != nil {
+					return
+				}
+				var destination netip.Addr
+				if n >= 20 && packet[0]>>4 == 4 {
+					destination = netip.AddrFrom4([4]byte(packet[16:20]))
+				} else if n >= 40 && packet[0]>>4 == 6 {
+					destination = netip.AddrFrom16([16]byte(packet[24:40]))
+				}
+				select {
+				case captured <- destination:
+				default:
+				}
+			}
+		}()
+		for _, target := range []string{"203.0.113.10", "2001:db8:70::10"} {
+			testSystemRouteUDP(t, target, 17, true)
+			testSystemRouteUDP(t, target, 0, false)
+			deadline := time.After(time.Second)
+			found := false
+			for !found {
+				select {
+				case destination := <-captured:
+					found = destination.String() == target
+				case <-deadline:
+					t.Fatalf("unmarked packet to %s did not enter TUN", target)
+				}
+			}
+		}
+		if err := device.Close(); err != nil {
+			t.Fatal(err)
+		}
+		if err := bypass.Close(); err != nil {
+			t.Fatal(err)
+		}
+		if err := bypass.Close(); err != nil {
+			t.Fatal("duplicate cleanup:", err)
+		}
+		if current := systemRouteRuleSnapshot(t); !reflect.DeepEqual(baseline, current) {
+			t.Fatalf("rules leaked or user policy changed after restart %d:\nbefore=%#v\nafter=%#v", iteration, baseline, current)
+		}
+	}
+	// A real TUN creation failure still rolls back only our preparatory rules.
+	bypass, err := newSystemRouteBypass(LC.Tun{SystemRouteMark: 17}, options)
+	if err != nil {
+		t.Fatal(err)
+	}
+	invalid := options
+	invalid.Name = "invalid/tun/name"
+	if device, err := tun.New(invalid); err == nil {
+		_ = device.Close()
+		t.Fatal("invalid device name was accepted")
+	}
+	if err := bypass.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if current := systemRouteRuleSnapshot(t); !reflect.DeepEqual(baseline, current) {
+		t.Fatal("pre-start rollback changed user rules")
+	}
+	for _, family := range []int{unix.AF_INET, unix.AF_INET6} {
+		for _, priority := range []int{start - 1, start + 5} {
+			rule := netlink.NewRule()
+			rule.Family, rule.Priority, rule.Table = family, priority, 201
+			if priority == start-1 {
+				rule.Mark, rule.MarkSet = 17, true
+			}
+			if err := netlink.RuleAdd(rule); err != nil {
+				t.Fatal(err)
+			}
+			before := systemRouteRuleSnapshot(t)
+			if added, err := newSystemRouteBypass(LC.Tun{SystemRouteMark: 17}, options); err == nil {
+				_ = added.Close()
+				t.Fatal("conflicting user rule accepted")
+			}
+			if after := systemRouteRuleSnapshot(t); !reflect.DeepEqual(before, after) {
+				t.Fatal("failed preflight modified user's rules")
+			}
+			if err := netlink.RuleDel(rule); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+}
+
+func systemRouteRuleSnapshot(t *testing.T) []netlink.Rule {
+	t.Helper()
+	rules, err := netlink.RuleList(unix.AF_UNSPEC)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return rules
+}
+
+func testSystemRouteUDP(t *testing.T, target string, mark int, wantEcho bool) {
+	t.Helper()
+	dialer := net.Dialer{Timeout: time.Second, Control: func(_, _ string, raw syscall.RawConn) error {
+		var inner error
+		err := raw.Control(func(fd uintptr) { inner = unix.SetsockoptInt(int(fd), unix.SOL_SOCKET, unix.SO_MARK, mark) })
+		if err != nil {
+			return err
+		}
+		return inner
+	}}
+	conn, err := dialer.DialContext(context.Background(), "udp", net.JoinHostPort(target, "19090"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	_ = conn.SetDeadline(time.Now().Add(500 * time.Millisecond))
+	payload := []byte("system-route-mark-integration")
+	if _, err := conn.Write(payload); err != nil {
+		t.Fatal(err)
+	}
+	buffer := make([]byte, 2048)
+	n, err := conn.Read(buffer)
+	if wantEcho && (err != nil || !strings.EqualFold(string(buffer[:n]), string(payload))) {
+		t.Fatalf("marked %s did not follow later user route: %v %q", target, err, buffer[:n])
+	}
+	if !wantEcho && err == nil {
+		t.Fatalf("unmarked %s bypassed TUN", target)
+	}
+}
