+++ b/config/tun_system_route_test.go
@@ -0,0 +1,113 @@
+package config
+
+import (
+	"runtime"
+	"testing"
+
+	"github.com/metacubex/mihomo/adapter"
+	"github.com/metacubex/mihomo/adapter/outbound"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+func TestTunSystemRouteMarkInference(t *testing.T) {
+	proxies := map[string]C.Proxy{}
+	for name, mark := range map[string]int{"home": 17, "same": 17, "other": 18, "zero": 0, "negative": -1} {
+		proxies[name] = adapter.NewProxy(outbound.NewDirectWithOption(outbound.DirectOption{
+			Name: name, BasicOption: outbound.BasicOption{RoutingMark: mark},
+		}))
+	}
+	for _, tc := range []struct {
+		name     string
+		explicit uint32
+		names    []string
+		want     uint32
+		wantErr  bool
+	}{
+		{"none", 0, nil, 0, false},
+		{"explicit-provider-mark", 17, nil, 17, false},
+		{"infer-static-adapter", 0, []string{"home"}, 17, false},
+		{"matching-explicit", 17, []string{"home"}, 17, false},
+		{"matching-adapters", 0, []string{"home", "same"}, 17, false},
+		{"explicit-conflict", 18, []string{"home"}, 0, true},
+		{"adapter-conflict", 0, []string{"home", "other"}, 0, true},
+		{"zero-mark", 0, []string{"zero"}, 0, true},
+		{"negative-mark", 0, []string{"negative"}, 0, true},
+		{"missing-adapter", 0, []string{"missing"}, 0, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			initial := RawTun{Enable: true, AutoRoute: true, AutoDetectInterface: true, SystemRouteMark: tc.explicit}
+			rawProxies := []map[string]any{{"name": "ordinary", "type": "direct", "routing-mark": 999}}
+			for _, name := range tc.names {
+				rawProxies = append(rawProxies, map[string]any{"type": "direct-system", "name": name})
+			}
+			resolved, err := resolveTunSystemRouteMark(initial, rawProxies, proxies)
+			if (err != nil) != tc.wantErr {
+				t.Fatalf("error=%v, wantErr=%v", err, tc.wantErr)
+			}
+			if err == nil && (resolved.SystemRouteMark != tc.want || !resolved.AutoDetectInterface || !resolved.AutoRoute || !resolved.Enable) {
+				t.Fatalf("unexpected TUN settings: %+v", resolved)
+			}
+			if initial.SystemRouteMark != tc.explicit {
+				t.Fatal("inference wrote derived state into caller's raw configuration")
+			}
+		})
+	}
+	// Removing the adapter restores the original TUN settings on hot reload.
+	original := RawTun{Enable: true, AutoRoute: true, AutoDetectInterface: true}
+	if resolved, err := resolveTunSystemRouteMark(original, nil, proxies); err != nil || resolved.SystemRouteMark != 0 {
+		t.Fatalf("removed adapter left an inferred mark: %+v %v", resolved, err)
+	}
+}
+
+func TestTunSystemRouteMarkParse(t *testing.T) {
+	proxy := adapter.NewProxy(outbound.NewDirectWithOption(outbound.DirectOption{
+		Name: "home", BasicOption: outbound.BasicOption{RoutingMark: 17},
+	}))
+	rawTun, err := resolveTunSystemRouteMark(RawTun{Enable: true, AutoRoute: true, AutoDetectInterface: true},
+		[]map[string]any{{"name": "home", "type": "direct-system"}}, map[string]C.Proxy{"home": proxy})
+	if err != nil {
+		t.Fatal(err)
+	}
+	general := &General{Interface: "designated-uplink"}
+	if err := parseTun(rawTun, &DNS{}, general); err != nil {
+		if runtime.GOOS != "linux" {
+			return
+		}
+		t.Fatal(err)
+	}
+	if runtime.GOOS != "linux" {
+		t.Fatal("non-Linux marked TUN passed preflight")
+	}
+	if general.Interface != "designated-uplink" || !general.Tun.AutoDetectInterface || general.Tun.SystemRouteMark != 17 {
+		t.Fatalf("inference changed ordinary binding behavior or missed mark: %+v", general)
+	}
+}
+
+func TestTunSystemRouteFreshParseValidation(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		apply   func(*RawTun)
+		wantErr bool
+	}{
+		{"valid", func(o *RawTun) {}, false},
+		{"no-auto-route", func(o *RawTun) { o.AutoRoute = false }, true},
+		{"auto-redirect", func(o *RawTun) { o.AutoRedirect = true }, true},
+		{"borrowed-fd", func(o *RawTun) { o.FileDescriptor = 3 }, true},
+		{"low-index", func(o *RawTun) { o.IPRoute2RuleIndex = 1 }, true},
+		{"high-index", func(o *RawTun) { o.IPRoute2RuleIndex = 32756 }, true},
+		{"disabled", func(o *RawTun) { o.Enable = false; o.AutoRoute = false }, false},
+		{"ordinary", func(o *RawTun) { o.SystemRouteMark = 0; o.AutoRoute = false }, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			raw := RawTun{Enable: true, AutoRoute: true, SystemRouteMark: 17}
+			tc.apply(&raw)
+			err := parseTun(raw, &DNS{}, &General{})
+			if runtime.GOOS != "linux" && raw.Enable && raw.SystemRouteMark != 0 {
+				tc.wantErr = true
+			}
+			if (err != nil) != tc.wantErr {
+				t.Fatalf("fresh parse error=%v wantErr=%v", err, tc.wantErr)
+			}
+		})
+	}
+}
