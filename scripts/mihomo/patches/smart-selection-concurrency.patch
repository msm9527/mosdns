diff --git a/adapter/outboundgroup/smart_selection_test.go b/adapter/outboundgroup/smart_selection_test.go
new file mode 100644
--- /dev/null
+++ b/adapter/outboundgroup/smart_selection_test.go
@@ -0,0 +1,62 @@
+package outboundgroup
+
+import (
+	"encoding/json"
+	"sync"
+	"testing"
+	"time"
+
+	C "github.com/metacubex/mihomo/constant"
+)
+
+func TestSmartSelectionConcurrent(t *testing.T) {
+	a := &nativeSelectionProxy{name: "node-a", alive: true}
+	b := &nativeSelectionProxy{name: "node-b", alive: true}
+	group := &Smart{GroupBase: nativeSelectionBase(C.Smart, a, b)}
+	group.ForceSet("node-a")
+	var worker sync.WaitGroup
+	worker.Add(1)
+	go func() {
+		defer worker.Done()
+		for i := 0; i < 2000; i++ {
+			metadata := &C.Metadata{Host: "example.com", DstIPASN: "unknown"}
+			proxies, fixed, _ := group.selectProxies(metadata, group.GetProxies(false))
+			if len(proxies) != 1 || !fixed {
+				t.Error("manual selection escaped the native data path")
+				return
+			}
+		}
+	}()
+	exerciseNativeSelection(t, group, false)
+	worker.Wait()
+}
+
+func TestSmartStaleSelectionDoesNotClearNewChoice(t *testing.T) {
+	entered, release := make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	a := &nativeSelectionProxy{name: "node-a", alive: true}
+	b := &nativeSelectionProxy{name: "node-b", alive: true, nameHook: func() {
+		once.Do(func() { close(entered) })
+		<-release
+	}}
+	group := &Smart{GroupBase: nativeSelectionBase(C.Smart, a, b)}
+	group.ForceSet("missing")
+	finished := make(chan struct{})
+	go func() { defer close(finished); group.Now() }()
+	select {
+	case <-entered:
+	case <-time.After(5 * time.Second):
+		close(release)
+		t.Fatal("native proxy validation was not reached")
+	}
+	group.ForceSet("node-a")
+	close(release)
+	<-finished
+	data, err := group.MarshalJSON()
+	var state struct {
+		Fixed string `json:"fixed"`
+	}
+	if err != nil || json.Unmarshal(data, &state) != nil || state.Fixed != "node-a" {
+		t.Fatalf("stale proxy validation cleared the newer selection: %s (%v)", data, err)
+	}
+}
