new file mode 100644
index 0000000..8de14fe
--- /dev/null
+++ b/config/smart_updater_test.go
@@ -0,0 +1,23 @@
+package config
+
+import (
+	"testing"
+	"time"
+)
+
+func TestSmartModelUpdaterIntervalValidation(t *testing.T) {
+	maximum := int((1<<63 - 1) / time.Hour)
+	for _, hours := range []int{-1, 0, maximum + 1} {
+		if _, err := parseGeneral(&RawConfig{LgbmAutoUpdate: true, LgbmUpdateInterval: hours}); err == nil {
+			t.Fatalf("accepted invalid enabled model interval %d", hours)
+		}
+	}
+	for _, hours := range []int{1, 72, 720, maximum} {
+		if _, err := parseGeneral(&RawConfig{LgbmAutoUpdate: true, LgbmUpdateInterval: hours}); err != nil {
+			t.Fatalf("rejected valid model interval %d: %v", hours, err)
+		}
+	}
+	if _, err := parseGeneral(&RawConfig{LgbmAutoUpdate: false, LgbmUpdateInterval: 0}); err != nil {
+		t.Fatalf("cannot disable model updater: %v", err)
+	}
+}
