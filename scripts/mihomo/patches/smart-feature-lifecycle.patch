@@ -0,0 +1,96 @@
+package outboundgroup
+
+import (
+	"net/netip"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/component/smart"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+func TestSmartASNUnavailableFallback(t *testing.T) {
+	old := C.Path.HomeDir()
+	C.SetHomeDir(t.TempDir())
+	defer C.SetHomeDir(old)
+	s := &Smart{
+		GroupBase: NewGroupBase(GroupBaseOption{Name: "asn-test", Type: C.Smart}),
+		preferASN: true,
+		asnError:  "database unavailable",
+	}
+	metadata := &C.Metadata{DstIP: netip.MustParseAddr("1.1.1.1")}
+	if asn := s.getASNCode(metadata); asn != "" {
+		t.Fatalf("missing database produced ASN %q", asn)
+	}
+	if ready, err := s.asnStatus(); ready || err == "" {
+		t.Fatalf("missing database status: %v %q", ready, err)
+	}
+	if err := os.WriteFile(C.Path.ASN(), []byte("invalid MaxMind data"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	s.asnLastCheck = time.Time{}
+	metadata.DstIPASN = ""
+	if asn := s.getASNCode(metadata); asn != "" {
+		t.Fatalf("invalid database produced ASN %q", asn)
+	}
+	if ready, _ := s.asnStatus(); ready {
+		t.Fatal("invalid database marked ready")
+	}
+}
+
+func TestSmartGlobalTasksSurviveGroupReplacement(t *testing.T) {
+	group := func(name string) *Smart {
+		return &Smart{GroupBase: NewGroupBase(GroupBaseOption{Name: name, Type: C.Smart}), store: &smart.Store{}}
+	}
+	first, replacement := group("first"), group("replacement")
+	first.acquireGlobalTasks()
+	worker := smartGlobals.worker
+	replacement.acquireGlobalTasks()
+	first.releaseGlobalTasks()
+	if smartGlobals.worker != worker {
+		t.Fatal("replacing first group replaced the shared worker")
+	}
+	select {
+	case <-worker.ctx.Done():
+		t.Fatal("old group closed maintenance needed by replacement")
+	default:
+	}
+	replacement.releaseGlobalTasks()
+	if smartGlobals.worker != nil || smartGlobals.users != 0 {
+		t.Fatal("last group leaked shared worker")
+	}
+	select {
+	case <-worker.ctx.Done():
+	default:
+		t.Fatal("last group did not stop shared worker")
+	}
+	next := group("next")
+	next.acquireGlobalTasks()
+	if smartGlobals.worker == worker {
+		t.Fatal("new lifecycle reused stopped worker")
+	}
+	next.releaseGlobalTasks()
+}
+
+func TestSmartDialBudgetAllowsTransientJitter(t *testing.T) {
+	for _, tc := range []struct {
+		name          string
+		history       int64
+		maximum, want time.Duration
+	}{
+		{"unknown", 0, 5 * time.Second, 5 * time.Second},
+		{"lan", 1, 5 * time.Second, time.Second},
+		{"normal", 30, 5 * time.Second, time.Second},
+		{"slow", 400, 5 * time.Second, 2 * time.Second},
+		{"capped", 5000, 5 * time.Second, 5 * time.Second},
+		{"explicit-short", 1, 50 * time.Millisecond, 50 * time.Millisecond},
+		{"overflow", 1 << 62, 5 * time.Second, 5 * time.Second},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := smartDialBudget(tc.history, tc.maximum); got != tc.want {
+				t.Fatalf("budget=%v, want=%v", got, tc.want)
+			}
+		})
+	}
+}
