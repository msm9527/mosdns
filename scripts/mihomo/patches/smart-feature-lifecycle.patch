diff --git a/adapter/outboundgroup/smart_feature_lifecycle.go b/adapter/outboundgroup/smart_feature_lifecycle.go
new file mode 100644
index 0000000..1ac2ada
--- /dev/null
+++ b/adapter/outboundgroup/smart_feature_lifecycle.go
@@ -0,0 +1,88 @@
+package outboundgroup
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	"github.com/metacubex/mihomo/component/mmdb"
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/metacubex/mihomo/log"
+)
+
+var smartGlobals struct {
+	sync.Mutex
+	users  int
+	worker *Smart
+}
+
+// Millisecond LAN history is an estimate, not a safe handshake deadline. Keep
+// room for scheduler jitter, transient congestion and proxy protocol handshakes,
+// while preserving a shorter explicit limit supplied by the caller.
+func smartDialBudget(historyMilliseconds int64, maximum time.Duration) time.Duration {
+	if historyMilliseconds <= 0 || maximum <= 0 {
+		return maximum
+	}
+	if historyMilliseconds >= maximum.Milliseconds()/int64(connectThreshold) {
+		return maximum
+	}
+	budget := time.Duration(historyMilliseconds) * time.Millisecond * time.Duration(connectThreshold)
+	if budget < time.Second {
+		budget = time.Second
+	}
+	if budget > maximum {
+		return maximum
+	}
+	return budget
+}
+
+// Global maintenance must outlive whichever group happened to initialize first.
+// During reload, the replacement groups are parsed before old groups close.
+func (s *Smart) acquireGlobalTasks() {
+	smartGlobals.Lock()
+	defer smartGlobals.Unlock()
+	smartGlobals.users++
+	if smartGlobals.worker != nil {
+		return
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	worker := &Smart{GroupBase: s.GroupBase, store: s.store, ctx: ctx, cancel: cancel}
+	smartGlobals.worker = worker
+	worker.startTimedTask(5*time.Second, cacheParamAdjustInterval, "Global cache parameters adjustment", worker.store.AdjustCacheParameters, false)
+	worker.startTimedTask(5*time.Minute, flushQueueInterval, "Global queues flush", func() {
+		worker.store.FlushQueue(true)
+	}, false)
+}
+
+func (s *Smart) releaseGlobalTasks() {
+	smartGlobals.Lock()
+	defer smartGlobals.Unlock()
+	smartGlobals.users--
+	if smartGlobals.users != 0 || smartGlobals.worker == nil {
+		return
+	}
+	worker := smartGlobals.worker
+	smartGlobals.worker = nil
+	worker.cancel()
+	worker.wg.Wait()
+}
+
+// asnStatus retries only a local validation after an unavailable database. This
+// allows a successful updater or user-installed database to take effect without
+// restarting the core or making a network download on a user's request path.
+func (s *Smart) asnStatus() (bool, string) {
+	if !s.preferASN {
+		return false, ""
+	}
+	s.asnMutex.Lock()
+	defer s.asnMutex.Unlock()
+	if !s.asnReady && time.Since(s.asnLastCheck) >= 5*time.Second {
+		s.asnLastCheck = time.Now()
+		if mmdb.Verify(C.Path.ASN()) {
+			s.asnReady = true
+			s.asnError = ""
+			log.Infoln("[Smart] ASN preference recovered for %s", s.Name())
+		}
+	}
+	return s.asnReady, s.asnError
+}
