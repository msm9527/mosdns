+
+	"github.com/metacubex/mihomo/component/smart/lightgbm"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+func waitSmartUpdater(t *testing.T, condition func() bool) {
+	t.Helper()
+	deadline := time.Now().Add(3 * time.Second)
+	for time.Now().Before(deadline) {
+		if condition() {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	t.Fatal("timed out waiting for model updater")
+}
+
+func smartUpdaterFixture(t *testing.T, handler http.HandlerFunc) (*lgbmUpdateScheduler, string) {
+	t.Helper()
+	oldHome, oldURL := C.Path.HomeDir(), lightgbm.LgbmUrl()
+	C.SetHomeDir(t.TempDir())
+	path := filepath.Join(C.Path.HomeDir(), "Model.bin")
+	server := httptest.NewServer(handler)
+	lightgbm.SetLgbmUrl(server.URL)
+	scheduler := newLgbmUpdateScheduler()
+	t.Cleanup(func() {
+		scheduler.close()
+		server.Close()
+		C.SetHomeDir(oldHome)
+		lightgbm.SetLgbmUrl(oldURL)
+	})
+	return scheduler, path
+}
+
+func TestSmartModelUpdaterHotReload(t *testing.T) {
+	var requests atomic.Int32
+	scheduler, path := smartUpdaterFixture(t, func(w http.ResponseWriter, _ *http.Request) {
+		requests.Add(1)
+		_, _ = w.Write([]byte(lifecycleUpdateModel))
+	})
+	if err := os.WriteFile(path, []byte(lifecycleUpdateModel), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	// Disabled startup does nothing, then enabling starts the timer in place.
+	scheduler.configure(false, 20*time.Millisecond)
+	time.Sleep(50 * time.Millisecond)
+	if requests.Load() != 0 {
+		t.Fatal("disabled updater downloaded a model")
+	}
+	scheduler.configure(true, 20*time.Millisecond)
+	waitSmartUpdater(t, func() bool { return requests.Load() >= 2 })
+
+	// Changing the interval replaces the old timer, without an extra worker.
+	now := time.Now()
+	if err := os.Chtimes(path, now, now); err != nil {
+		t.Fatal(err)
+	}
+	scheduler.configure(true, 300*time.Millisecond)
+	time.Sleep(30 * time.Millisecond)
+	before := requests.Load()
+	time.Sleep(100 * time.Millisecond)
+	if got := requests.Load(); got != before {
+		t.Fatalf("old short timer survived interval change: %d -> %d", before, got)
+	}
+	waitSmartUpdater(t, func() bool { return requests.Load() > before })
+
+	// Disabling stops scheduled work, but the manual API remains usable.
+	scheduler.configure(false, 300*time.Millisecond)
+	time.Sleep(30 * time.Millisecond)
+	before = requests.Load()
+	time.Sleep(350 * time.Millisecond)
+	if got := requests.Load(); got != before {
+		t.Fatalf("disabled timer still downloaded: %d -> %d", before, got)
+	}
+	if err := UpdateLgbmModelDatabase(); err != nil {
+		t.Fatal(err)
+	}
+	if got := requests.Load(); got != before+1 {
+		t.Fatalf("manual model update no longer works while disabled: %d -> %d", before, got)
+	}
+}
+
+func TestSmartModelUpdaterCancellationAndIdempotence(t *testing.T) {
+	var requests atomic.Int32
+	canceled := make(chan struct{}, 4)
+	scheduler, _ := smartUpdaterFixture(t, func(_ http.ResponseWriter, r *http.Request) {
+		requests.Add(1)
+		<-r.Context().Done()
+		canceled <- struct{}{}
+	})
+	scheduler.configure(true, 20*time.Millisecond)
+	waitSmartUpdater(t, func() bool { return requests.Load() == 1 })
+	for i := 0; i < 100; i++ {
+		scheduler.configure(true, 20*time.Millisecond)
+	}
+	time.Sleep(50 * time.Millisecond)
+	if requests.Load() != 1 {
+		t.Fatal("idempotent registration created another updater")
+	}
+	select {
+	case <-canceled:
+		t.Fatal("unchanged policy canceled its active download")
+	default:
+	}
+	scheduler.configure(false, 20*time.Millisecond)
+	select {
+	case <-canceled:
+	case <-time.After(3 * time.Second):
+		t.Fatal("disable did not cancel automatic model download")
+	}
+	scheduler.configure(true, 100*time.Millisecond)
+	waitSmartUpdater(t, func() bool { return requests.Load() == 2 })
+	scheduler.configure(true, 200*time.Millisecond)
+	select {
+	case <-canceled:
+	case <-time.After(3 * time.Second):
+		t.Fatal("interval change did not cancel the old automatic download")
+	}
+	waitSmartUpdater(t, func() bool { return requests.Load() == 3 })
+	scheduler.configure(false, 200*time.Millisecond)
+	select {
+	case <-canceled:
+	case <-time.After(3 * time.Second):
+		t.Fatal("replacement automatic download did not stop")
+	}
+	// Configuring after close cannot restart the worker or create a leak.
+	scheduler.close()
+	scheduler.configure(true, time.Millisecond)
+	time.Sleep(30 * time.Millisecond)
+	if got := requests.Load(); got != 3 {
+		t.Fatalf("scheduler restarted after close: %d requests", got)
+	}
+}
+
+func TestSmartModelUpdaterPolicyConcurrentRegistration(t *testing.T) {
+	oldEnabled, oldHours := LgbmAutoUpdate(), LgbmUpdateInterval()
+	defer ConfigureLgbmUpdater(oldEnabled, oldHours)
+	ConfigureLgbmUpdater(false, 1)
+	var wg sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for hours := 1; hours <= 100; hours++ {
+				SetLgbmAutoUpdate(false)
+				SetLgbmUpdateInterval(hours)
+				_ = LgbmAutoUpdate()
+				_ = LgbmUpdateInterval()
+				RegisterLgbmUpdater()
+				ConfigureLgbmUpdater(false, hours)
+			}
+		}()
+	}
+	wg.Wait()
+	for _, hours := range []int{-1, 0, int((1<<63-1)/int64(time.Hour)) + 1} {
+		ConfigureLgbmUpdater(true, hours)
+		lgbmScheduler.mutex.Lock()
+		enabled := lgbmScheduler.enabled
+		lgbmScheduler.mutex.Unlock()
+		if enabled {
+			t.Fatalf("invalid duration started a scheduler: %d", hours)
+		}
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if err := updateLgbmModelDatabaseContext(ctx); err != context.Canceled {
+		t.Fatalf("canceled update must not start: %v", err)
+	}
+}
