+		_, _ = w.Write([]byte(lifecycleUpdateModel))
+	}))
+	defer server.Close()
+	lightgbm.SetLgbmUrl(server.URL)
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan struct{})
+	go func() { defer close(done); runLgbmUpdater(ctx, 20*time.Millisecond) }()
+	defer func() { cancel(); <-done }()
+	deadline := time.Now().Add(2 * time.Second)
+	for time.Now().Before(deadline) {
+		if data, err := os.ReadFile(C.Path.SmartModel()); err == nil && string(data) == lifecycleUpdateModel {
+			if ready, _ := lightgbm.GetModel().Status(); ready {
+				return
+			}
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	t.Fatalf("auto updater stopped after temporary failure; requests=%d", requests.Load())
+}
