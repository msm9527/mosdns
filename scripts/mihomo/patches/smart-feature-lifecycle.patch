diff --git a/component/updater/lgbm_scheduler.go b/component/updater/lgbm_scheduler.go
new file mode 100644
index 0000000..509f786
--- /dev/null
+++ b/component/updater/lgbm_scheduler.go
@@ -0,0 +1,137 @@
+package updater
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	"github.com/metacubex/mihomo/log"
+)
+
+var lgbmPolicy struct {
+	sync.RWMutex
+	enabled bool
+	hours   int
+}
+
+var lgbmScheduler = newLgbmUpdateScheduler()
+
+func LgbmAutoUpdate() bool {
+	enabled, _ := LgbmUpdatePolicy()
+	return enabled
+}
+
+func LgbmUpdateInterval() int {
+	_, hours := LgbmUpdatePolicy()
+	return hours
+}
+
+func LgbmUpdatePolicy() (bool, int) {
+	lgbmPolicy.RLock()
+	defer lgbmPolicy.RUnlock()
+	return lgbmPolicy.enabled, lgbmPolicy.hours
+}
+
+// Keep the existing setters safe for callers that stage policy before Register.
+// Committing a configuration uses ConfigureLgbmUpdater to apply both together.
+func SetLgbmAutoUpdate(enabled bool) {
+	lgbmPolicy.Lock()
+	defer lgbmPolicy.Unlock()
+	lgbmPolicy.enabled = enabled
+}
+
+func SetLgbmUpdateInterval(hours int) {
+	lgbmPolicy.Lock()
+	defer lgbmPolicy.Unlock()
+	lgbmPolicy.hours = hours
+}
+
+func ConfigureLgbmUpdater(enabled bool, hours int) {
+	lgbmPolicy.Lock()
+	defer lgbmPolicy.Unlock()
+	lgbmPolicy.enabled, lgbmPolicy.hours = enabled, hours
+	registerLgbmUpdaterLocked()
+}
+
+// main.go may register after the first committed configuration. Applying the
+// same policy is idempotent and must not create a second worker or reset a tick.
+func RegisterLgbmUpdater() {
+	lgbmPolicy.Lock()
+	defer lgbmPolicy.Unlock()
+	registerLgbmUpdaterLocked()
+}
+
+func registerLgbmUpdaterLocked() {
+	hours := lgbmPolicy.hours
+	if hours <= 0 || hours > int((1<<63-1)/int64(time.Hour)) {
+		if lgbmPolicy.enabled {
+			log.Errorln("[Smart] Invalid update interval: %d", hours)
+		}
+		lgbmScheduler.configure(false, 0)
+		return
+	}
+	lgbmScheduler.configure(lgbmPolicy.enabled, time.Duration(hours)*time.Hour)
+}
+
+// There is exactly one scheduler goroutine. Reconfiguration cancels its current
+// automatic HTTP request and coalesces notifications; it never adds workers.
+type lgbmUpdateScheduler struct {
+	mutex        sync.Mutex
+	enabled      bool
+	interval     time.Duration
+	wake         chan struct{}
+	ctx          context.Context
+	cancel       context.CancelFunc
+	cancelUpdate context.CancelFunc
+	done         chan struct{}
+}
+
+func newLgbmUpdateScheduler() *lgbmUpdateScheduler {
+	ctx, cancel := context.WithCancel(context.Background())
+	s := &lgbmUpdateScheduler{wake: make(chan struct{}, 1), ctx: ctx, cancel: cancel, done: make(chan struct{})}
+	go s.run()
+	return s
+}
+
+func (s *lgbmUpdateScheduler) configure(enabled bool, interval time.Duration) {
+	s.mutex.Lock()
+	defer s.mutex.Unlock()
+	if s.ctx.Err() != nil || (s.enabled == enabled && s.interval == interval) {
+		return
+	}
+	s.enabled, s.interval = enabled, interval
+	if s.cancelUpdate != nil {
+		s.cancelUpdate()
+	}
+	select {
+	case s.wake <- struct{}{}:
+	default:
+	}
+}
+
+func (s *lgbmUpdateScheduler) run() {
+	defer close(s.done)
+	for {
+		select {
+		case <-s.ctx.Done():
+			return
+		case <-s.wake:
+		}
+		s.mutex.Lock()
+		if !s.enabled || s.interval <= 0 {
+			s.mutex.Unlock()
+			continue
+		}
+		ctx, cancel := context.WithCancel(s.ctx)
+		s.cancelUpdate = cancel
+		interval := s.interval
+		s.mutex.Unlock()
+		runLgbmUpdater(ctx, interval)
+		cancel()
+	}
+}
+
+func (s *lgbmUpdateScheduler) close() {
+	s.cancel()
+	<-s.done
+}
