@@ -0,0 +1,216 @@
+package lightgbm
+
+import (
+	"encoding/csv"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+
+	"github.com/metacubex/mihomo/component/smart"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+const lifecycleModel = `tree
+version=v4
+num_class=1
+num_tree_per_iteration=1
+label_index=0
+max_feature_idx=0
+objective=regression
+tree_sizes=200
+
+Tree=0
+num_leaves=2
+num_cat=0
+split_feature=0
+threshold=5.0
+decision_type=2
+left_child=-1
+right_child=-2
+leaf_count=300 700
+leaf_value=0.43 0.59
+
+end of trees
+`
+
+func lifecycleHome(t *testing.T) string {
+	t.Helper()
+	old := C.Path.HomeDir()
+	home := t.TempDir()
+	C.SetHomeDir(home)
+	t.Cleanup(func() { C.SetHomeDir(old) })
+	return home
+}
+
+func TestSmartModelRecoveryAndAtomicDownload(t *testing.T) {
+	home := lifecycleHome(t)
+	oldURL := LgbmUrl()
+	smartModel, modelOnce = nil, sync.Once{}
+	t.Cleanup(func() { smartModel, modelOnce = nil, sync.Once{}; SetLgbmUrl(oldURL) })
+	status, body := http.StatusServiceUnavailable, "temporarily unavailable"
+	var contentLength string
+	requests := 0
+	var serverMutex sync.Mutex
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		serverMutex.Lock()
+		requests++
+		code, response, length := status, body, contentLength
+		serverMutex.Unlock()
+		if length != "" {
+			w.Header().Set("Content-Length", length)
+		}
+		w.WriteHeader(code)
+		_, _ = w.Write([]byte(response))
+	}))
+	defer server.Close()
+	SetLgbmUrl(server.URL)
+	m := GetModel()
+	if m == nil {
+		t.Fatal("failed first download must retain a recoverable model handle")
+	}
+	if ready, err := m.Status(); ready || !strings.Contains(err, "503") {
+		t.Fatalf("first failure status: %v %q", ready, err)
+	}
+	if _, err := os.Stat(C.Path.SmartModel()); !os.IsNotExist(err) {
+		t.Fatalf("HTTP error body was installed: %v", err)
+	}
+	serverMutex.Lock()
+	requestCount := requests
+	serverMutex.Unlock()
+	if GetModel() != m || requestCount != 1 {
+		t.Fatal("GetModel changed handle or retried on every access")
+	}
+	serverMutex.Lock()
+	status, body = http.StatusOK, lifecycleModel
+	serverMutex.Unlock()
+	if err := downloadModel(C.Path.SmartModel()); err != nil {
+		t.Fatal(err)
+	}
+	ReloadModel()
+	if ready, err := m.Status(); !ready || err != "" {
+		t.Fatalf("model did not recover in place: %v %q", ready, err)
+	}
+	input := &smart.ModelInput{Success: 3, IsTCP: true, ConnectTime: 5, Latency: 10}
+	if weight, model := m.PredictWeight(input, 1.5); !model || weight <= 0 {
+		t.Fatalf("CGO-free inference not active: %v %v", weight, model)
+	}
+	good, err := os.ReadFile(C.Path.SmartModel())
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		name         string
+		status       int
+		body, length string
+	}{
+		{"non-200", 503, lifecycleModel, ""},
+		{"invalid-model", 200, "not a model", ""},
+		{"empty", 200, "", ""},
+		{"truncated", 200, lifecycleModel, "10000"},
+		{"oversized-header", 200, "", fmt.Sprint(maxModelDownloadBytes + 1)},
+		{"unsafe-feature-count", 200, strings.Replace(lifecycleModel, "max_feature_idx=0", "max_feature_idx=5000", 1), ""},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			serverMutex.Lock()
+			status, body, contentLength = tc.status, tc.body, tc.length
+			serverMutex.Unlock()
+			if err := downloadModel(C.Path.SmartModel()); err == nil {
+				t.Fatal("unsafe download accepted")
+			}
+			current, err := os.ReadFile(C.Path.SmartModel())
+			if err != nil || string(current) != string(good) {
+				t.Fatalf("working model was replaced: %v", err)
+			}
+			staged, err := filepath.Glob(filepath.Join(home, ".Model.bin-*"))
+			if err != nil || len(staged) != 0 {
+				t.Fatalf("staged files leaked: %v %v", staged, err)
+			}
+		})
+	}
+	if err := os.WriteFile(C.Path.SmartModel(), []byte("invalid"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	ReloadModel()
+	if ready, err := m.Status(); !ready || err == "" {
+		t.Fatalf("bad reload discarded active model or hid error: %v %q", ready, err)
+	}
+	if _, model := m.PredictWeight(input, 1); !model {
+		t.Fatal("failed reload disabled working inference")
+	}
+}
+
+func TestSmartCollectorConfigurationLifecycle(t *testing.T) {
+	home := lifecycleHome(t)
+	CloseAllCollectors()
+	old := smartCollector
+	smartCollector = nil
+	t.Cleanup(func() { CloseAllCollectors(); smartCollector = old })
+	InitCollector(1)
+	c := GetCollector()
+	input := &smart.ModelInput{Success: 3, IsTCP: true, GroupName: "group", NodeName: "node"}
+	metadata := &C.Metadata{}
+	for i := 0; i < 3; i++ {
+		c.AddSample(input, metadata, .5, "Traditional")
+	}
+	InitCollector(2) // temporary general, rollback and final apply must share a writer
+	if GetCollector() != c {
+		t.Fatal("configuration replaced the collector referenced by groups")
+	}
+	CloseAllCollectors()
+	countRows := func() int {
+		f, err := os.Open(filepath.Join(home, "smart_weight_data.csv"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer f.Close()
+		rows, err := csv.NewReader(f).ReadAll()
+		if err != nil {
+			t.Fatal(err)
+		}
+		return len(rows) - 1
+	}
+	if n := countRows(); n != 3 {
+		t.Fatalf("graceful close lost buffered samples: %d", n)
+	}
+	before, _ := os.ReadDir("/proc/self/fd")
+	for i := 0; i < 40; i++ {
+		InitCollector(float64(i%3 + 1))
+		c.AddSample(input, metadata, .5, "Traditional")
+		CloseAllCollectors()
+	}
+	if n := countRows(); n != 43 {
+		t.Fatalf("reload/close lost or duplicated samples: %d", n)
+	}
+	after, err := os.ReadDir("/proc/self/fd")
+	if err == nil && len(after) > len(before)+1 {
+		t.Fatalf("collector leaked FDs: %d -> %d", len(before), len(after))
+	}
+	var wg sync.WaitGroup
+	for i := 0; i < 4; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for j := 0; j < 20; j++ {
+				c.AddSample(input, metadata, .5, "Traditional")
+			}
+		}()
+	}
+	wg.Add(1)
+	go func() {
+		defer wg.Done()
+		for j := 0; j < 20; j++ {
+			InitCollector(1)
+			CloseAllCollectors()
+		}
+	}()
+	wg.Wait()
+	CloseAllCollectors()
+	if n := countRows(); n != 123 {
+		t.Fatalf("concurrent reload/close lost samples: %d", n)
+	}
+}
