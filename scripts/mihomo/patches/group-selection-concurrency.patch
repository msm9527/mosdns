--- /dev/null
+++ b/adapter/outboundgroup/native_selection_test.go
@@ -0,0 +1,172 @@
+package outboundgroup
+
+import (
+	"encoding/json"
+	"fmt"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/common/singledo"
+	C "github.com/metacubex/mihomo/constant"
+)
+
+type nativeSelectionProxy struct {
+	C.Proxy
+	name      string
+	alive     bool
+	delay     uint16
+	nameHook  func()
+	aliveHook func()
+}
+
+func (p *nativeSelectionProxy) Name() string {
+	if p.nameHook != nil {
+		p.nameHook()
+	}
+	return p.name
+}
+func (p *nativeSelectionProxy) AliveForTestUrl(string) bool {
+	if p.aliveHook != nil {
+		p.aliveHook()
+	}
+	return p.alive
+}
+func (p *nativeSelectionProxy) LastDelayForTestUrl(string) uint16 { return p.delay }
+
+func nativeSelectionBase(kind C.AdapterType, proxies ...C.Proxy) *GroupBase {
+	base := NewGroupBase(GroupBaseOption{Name: "native-selection", Type: kind, EmptyFallback: proxies[0]})
+	// An immutable provider snapshot exercises native methods without background
+	// health checks or the network changing proxy liveness during this test.
+	base.providerProxies = proxies
+	return base
+}
+
+type nativeSelectionGroup interface {
+	Set(string) error
+	ForceSet(string)
+	Now() string
+	MarshalJSON() ([]byte, error)
+	Unwrap(*C.Metadata, bool) C.Proxy
+}
+
+func exerciseNativeSelection(t *testing.T, group nativeSelectionGroup, automatic bool) {
+	t.Helper()
+	if err := group.Set("node-a"); err != nil {
+		t.Fatal(err)
+	}
+	start := make(chan struct{})
+	errors := make(chan error, 4)
+	var workers sync.WaitGroup
+	for role := 0; role < 4; role++ {
+		workers.Add(1)
+		go func(role int) {
+			defer workers.Done()
+			<-start
+			for i := 0; i < 1000; i++ {
+				switch role {
+				case 0:
+					if err := group.Set([]string{"node-a", "node-b"}[i%2]); err != nil {
+						errors <- err
+						return
+					}
+					if automatic {
+						group.ForceSet("")
+					}
+				case 1:
+					if now := group.Now(); now != "node-a" && now != "node-b" {
+						errors <- fmt.Errorf("invalid current selection %q", now)
+						return
+					}
+				case 2:
+					data, err := group.MarshalJSON()
+					if err != nil || !json.Valid(data) {
+						errors <- fmt.Errorf("invalid proxy JSON: %s (%v)", data, err)
+						return
+					}
+				case 3:
+					if proxy := group.Unwrap(&C.Metadata{Host: "example.com"}, false); proxy == nil {
+						errors <- fmt.Errorf("missing data-path proxy")
+						return
+					}
+				}
+			}
+		}(role)
+	}
+	close(start)
+	workers.Wait()
+	close(errors)
+	for err := range errors {
+		t.Error(err)
+	}
+	if err := group.Set("node-b"); err != nil || group.Now() != "node-b" {
+		t.Fatalf("final selected node was lost: %v", err)
+	}
+	if err := group.Set("missing"); err == nil || group.Now() != "node-b" {
+		t.Fatal("invalid selection replaced the current node")
+	}
+}
+
+func TestNativeGroupSelectionConcurrent(t *testing.T) {
+	for _, kind := range []C.AdapterType{C.Selector, C.URLTest, C.Fallback} {
+		t.Run(kind.String(), func(t *testing.T) {
+			a := &nativeSelectionProxy{name: "node-a", alive: true, delay: 10}
+			b := &nativeSelectionProxy{name: "node-b", alive: true, delay: 20}
+			base := nativeSelectionBase(kind, a, b)
+			var group nativeSelectionGroup
+			switch kind {
+			case C.Selector:
+				group = &Selector{GroupBase: base}
+			case C.URLTest:
+				group = &URLTest{GroupBase: base, fastSingle: singledo.NewSingle[C.Proxy](time.Second)}
+			case C.Fallback:
+				group = &Fallback{GroupBase: base}
+			}
+			exerciseNativeSelection(t, group, true)
+		})
+	}
+}
+
+func TestSelectorDefaultSelection(t *testing.T) {
+	a := &nativeSelectionProxy{name: "node-a", alive: true}
+	b := &nativeSelectionProxy{name: "node-b", alive: true}
+	group, err := NewSelector(GroupCommonOption{Name: "default-selection"},
+		SelectorOption{DefaultSelected: "node-b"}, a, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	group.GroupBase.providerProxies = []C.Proxy{a, b}
+	if group.Now() != "node-b" {
+		t.Fatal("constructor ignored the configured default selection")
+	}
+}
+
+func TestFallbackStaleSelectionDoesNotClearNewChoice(t *testing.T) {
+	entered, release := make(chan struct{}), make(chan struct{})
+	var once sync.Once
+	a := &nativeSelectionProxy{name: "node-a", alive: false, aliveHook: func() {
+		once.Do(func() { close(entered) })
+		<-release
+	}}
+	b := &nativeSelectionProxy{name: "node-b", alive: true}
+	group := &Fallback{GroupBase: nativeSelectionBase(C.Fallback, a, b)}
+	group.ForceSet("node-a")
+	finished := make(chan struct{})
+	go func() { defer close(finished); group.Now() }()
+	select {
+	case <-entered:
+	case <-time.After(5 * time.Second):
+		close(release)
+		t.Fatal("native liveness check was not reached")
+	}
+	group.ForceSet("node-b")
+	close(release)
+	<-finished
+	data, err := group.MarshalJSON()
+	var state struct {
+		Fixed string `json:"fixed"`
+	}
+	if err != nil || json.Unmarshal(data, &state) != nil || state.Fixed != "node-b" {
+		t.Fatalf("stale liveness check cleared the newer selection: %s (%v)", data, err)
+	}
+}
