 func (s *Smart) singleDialContext(ctx context.Context, proxy C.Proxy, metadata *C.Metadata, start time.Time) (c C.Conn, connectTime int64, err error) {
+	// A spent caller/batch budget is not an attempted node connection. In
+	// particular, later retry batches must not turn one deadline into many failures.
+	if err = ctx.Err(); err != nil {
+		return nil, 0, err
+	}
+	if s.ctx != nil && s.ctx.Err() != nil {
+		return nil, 0, s.ctx.Err()
+	}
 	c, err = proxy.DialContext(ctx, metadata)
 	connectTime = time.Since(start).Milliseconds()
 
