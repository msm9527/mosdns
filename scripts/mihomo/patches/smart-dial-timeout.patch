 		}
-		if !errors.Is(err, context.Canceled) && ctx.Err() == nil {
-			// metadata may be re-written by a later retry's selectProxies.
-			go s.recordConnectionStats(metadata.Clone(), proxy, connectTime, 0, 0, 0, 0, 0, 0, nil, nil, err)
+		if !errors.Is(err, context.Canceled) && ctx.Err() != context.Canceled && (s.ctx == nil || s.ctx.Err() == nil) {
+			// A deadline reached during an actual dial is node failure evidence,
+			// including adapters returning a socket timeout after ctx expires.
+			// Publish it before the next selection; canceled speculative losers
+			// and group shutdown never enter this path.
+			s.recordConnectionStats(metadata.Clone(), proxy, connectTime, 0, 0, 0, 0, 0, 0, nil, nil, err)
