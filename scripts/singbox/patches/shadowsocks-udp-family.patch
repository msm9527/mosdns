index 0000000..0a8287d
--- /dev/null
+++ b/shadowaead_2022/udp_family_test.go
@@ -0,0 +1,159 @@
+package shadowaead_2022_test
+
+import (
+	"context"
+	"crypto/rand"
+	"io"
+	"net"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-shadowsocks"
+	"github.com/sagernet/sing-shadowsocks/shadowaead_2022"
+	"github.com/sagernet/sing/common/auth"
+	"github.com/sagernet/sing/common/buf"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+type familyEvent struct {
+	connection                 int32
+	destination, payload, user string
+}
+type familyHandler struct {
+	connections atomic.Int32
+	events      chan familyEvent
+	errors      chan error
+}
+
+func (*familyHandler) NewConnection(context.Context, net.Conn, M.Metadata) error { return nil }
+func (h *familyHandler) NewError(_ context.Context, err error)                   { h.errors <- err }
+func (h *familyHandler) NewPacketConnection(ctx context.Context, conn N.PacketConn, _ M.Metadata) error {
+	id := h.connections.Add(1)
+	user, _ := auth.UserFromContext[string](ctx)
+	for {
+		packet := buf.NewPacket()
+		destination, err := conn.ReadPacket(packet)
+		if err != nil {
+			packet.Release()
+			return nil
+		}
+		h.events <- familyEvent{id, destination.String(), string(packet.Bytes()), user}
+		packet.Release()
+	}
+}
+
+type familyCapture struct{ wire []byte }
+
+func (c *familyCapture) Write(p []byte) (int, error) {
+	c.wire = append([]byte{}, p...)
+	return len(p), nil
+}
+func (*familyCapture) Read([]byte) (int, error)         { return 0, io.EOF }
+func (*familyCapture) Close() error                     { return nil }
+func (*familyCapture) LocalAddr() net.Addr              { return &net.UDPAddr{} }
+func (*familyCapture) RemoteAddr() net.Addr             { return &net.UDPAddr{} }
+func (*familyCapture) SetDeadline(time.Time) error      { return nil }
+func (*familyCapture) SetReadDeadline(time.Time) error  { return nil }
+func (*familyCapture) SetWriteDeadline(time.Time) error { return nil }
+
+// Every packet has a real 2022 encrypted header, session ID and replay counter.
+// The same crypto session must create independent network sockets per family,
+// while preserving multi-user authentication and same-family NAT reuse.
+func Test2022UDPNATSeparatesDestinationFamilies(t *testing.T) {
+	for _, methodName := range shadowaead_2022.List {
+		for _, multi := range []bool{false, true} {
+			if multi && methodName == "2022-blake3-chacha20-poly1305" {
+				continue
+			}
+			name := methodName + "/single"
+			if multi {
+				name = methodName + "/multi"
+			}
+			t.Run(name, func(t *testing.T) {
+				ctx, cancel := context.WithCancel(context.Background())
+				defer cancel()
+				handler := &familyHandler{events: make(chan familyEvent, 16), errors: make(chan error, 16)}
+				keySize := 32
+				if methodName == "2022-blake3-aes-128-gcm" {
+					keySize = 16
+				}
+				serverKey := make([]byte, keySize)
+				if _, err := rand.Read(serverKey); err != nil {
+					t.Fatal(err)
+				}
+				keys := [][]byte{serverKey}
+				var service N.UDPHandler
+				if multi {
+					multiService, err := shadowaead_2022.NewMultiService[string](methodName, serverKey, 300, handler, nil)
+					if err != nil {
+						t.Fatal(err)
+					}
+					userKey := make([]byte, keySize)
+					if _, err = rand.Read(userKey); err != nil {
+						t.Fatal(err)
+					}
+					if err = multiService.UpdateUsers([]string{"test-user"}, [][]byte{userKey}); err != nil {
+						t.Fatal(err)
+					}
+					service = multiService
+					keys = append(keys, userKey)
+				} else {
+					single, err := shadowaead_2022.NewService(methodName, serverKey, 300, handler, nil)
+					if err != nil {
+						t.Fatal(err)
+					}
+					service = single
+				}
+				method, err := shadowaead_2022.New(methodName, keys, nil)
+				if err != nil {
+					t.Fatal(err)
+				}
+				var _ shadowsocks.Method = method
+				capture := &familyCapture{}
+				client := method.DialPacketConn(capture)
+				groups := map[int]int32{}
+				for sequence, target := range []struct {
+					address string
+					group   int
+				}{
+					{"192.0.2.10:8001", 4}, {"192.0.2.11:8002", 4},
+					{"[2001:db8::10]:8001", 6}, {"[2001:db8::11]:8002", 6},
+					{"192.0.2.10:8001", 4}, {"[2001:db8::10]:8001", 6},
+				} {
+					destination := M.ParseSocksaddr(target.address)
+					payload := []byte{byte(sequence)}
+					if _, err = client.WriteTo(payload, destination); err != nil {
+						t.Fatal(err)
+					}
+					packet := buf.NewPacket()
+					packet.Write(capture.wire)
+					if err = service.NewPacket(ctx, nil, packet, M.Metadata{Source: M.ParseSocksaddr("127.0.0.1:40000")}); err != nil {
+						t.Fatal(err)
+					}
+					select {
+					case event := <-handler.events:
+						if event.destination != target.address || event.payload != string(payload) {
+							t.Fatalf("corrupted packet: %+v", event)
+						}
+						if multi && event.user != "test-user" {
+							t.Fatalf("lost authenticated user: %+v", event)
+						}
+						if previous, ok := groups[target.group]; ok && previous != event.connection {
+							t.Fatal("same-family NAT stopped reusing its connection")
+						}
+						groups[target.group] = event.connection
+						if groups[4] != 0 && groups[4] == groups[6] {
+							t.Fatal("IPv4 and IPv6 reused one network socket")
+						}
+					case err := <-handler.errors:
+						t.Fatal(err)
+					case <-time.After(time.Second):
+						t.Fatal("packet not dispatched")
+					}
+				}
+			})
+		}
+	}
+}
