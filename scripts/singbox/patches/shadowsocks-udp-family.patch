new file mode 100644
index 0000000..17c7e2f
--- /dev/null
+++ b/udp_family.go
@@ -0,0 +1,29 @@
+package shadowsocks
+
+import (
+	"strings"
+
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+// UDPFamilySessionKey prevents an IPv4-first NAT session from pinning later
+// IPv6 destinations to its IPv4 socket. Destinations in one IP family retain
+// their shared session and source port. Domain names are kept separate because
+// their address family is not known until the outbound resolves them.
+type UDPFamilySessionKey[T comparable] struct {
+	Session T
+	family  uint8
+	domain  string
+}
+
+func NewUDPFamilySessionKey[T comparable](session T, destination M.Socksaddr) UDPFamilySessionKey[T] {
+	key := UDPFamilySessionKey[T]{Session: session}
+	if destination.Fqdn != "" {
+		key.domain = strings.ToLower(strings.TrimSuffix(destination.Fqdn, "."))
+	} else if destination.IsIPv6() {
+		key.family = 6
+	} else {
+		key.family = 4
+	}
+	return key
+}
