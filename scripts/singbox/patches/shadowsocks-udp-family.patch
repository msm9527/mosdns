@@ -0,0 +1,133 @@
+package shadowsocks_test
+
+import (
+	"context"
+	"io"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-shadowsocks"
+	"github.com/sagernet/sing-shadowsocks/shadowaead"
+	"github.com/sagernet/sing/common/buf"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+type udpFamilyEvent struct {
+	connection  int
+	destination string
+	payload     string
+}
+
+type udpFamilyHandler struct {
+	connections int
+	events      chan udpFamilyEvent
+	errors      chan error
+}
+
+func (h *udpFamilyHandler) NewConnection(context.Context, net.Conn, M.Metadata) error { return nil }
+func (h *udpFamilyHandler) NewError(_ context.Context, err error)                     { h.errors <- err }
+func (h *udpFamilyHandler) NewPacketConnection(ctx context.Context, conn N.PacketConn, _ M.Metadata) error {
+	h.connections++
+	id := h.connections
+	for {
+		packet := buf.NewPacket()
+		destination, err := conn.ReadPacket(packet)
+		if err != nil {
+			packet.Release()
+			return nil
+		}
+		h.events <- udpFamilyEvent{id, destination.String(), string(packet.Bytes())}
+		packet.Release()
+	}
+}
+
+type udpFamilyCapture struct{ wire []byte }
+
+func (c *udpFamilyCapture) Write(p []byte) (int, error) {
+	c.wire = append([]byte{}, p...)
+	return len(p), nil
+}
+func (*udpFamilyCapture) Read([]byte) (int, error)         { return 0, io.EOF }
+func (*udpFamilyCapture) Close() error                     { return nil }
+func (*udpFamilyCapture) LocalAddr() net.Addr              { return &net.UDPAddr{} }
+func (*udpFamilyCapture) RemoteAddr() net.Addr             { return &net.UDPAddr{} }
+func (*udpFamilyCapture) SetDeadline(time.Time) error      { return nil }
+func (*udpFamilyCapture) SetReadDeadline(time.Time) error  { return nil }
+func (*udpFamilyCapture) SetWriteDeadline(time.Time) error { return nil }
+
+// Exercise encrypted frames with one peer source port, including an IPv6 packet
+// after IPv4 left a live server NAT entry. Same-family destinations keep their
+// connection; a domain whose family is unknown never reuses an IP-only entry.
+func TestUDPNATSeparatesDestinationFamilies(t *testing.T) {
+	for _, methodName := range []string{"none", "aes-128-gcm", "chacha20-ietf-poly1305"} {
+		t.Run(methodName, func(t *testing.T) {
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			handler := &udpFamilyHandler{events: make(chan udpFamilyEvent, 10), errors: make(chan error, 10)}
+			var method shadowsocks.Method
+			var service shadowsocks.Service
+			if methodName == "none" {
+				method = shadowsocks.NewNone()
+				service = shadowsocks.NewNoneService(300, handler)
+			} else {
+				var err error
+				method, err = shadowaead.New(methodName, nil, "isolated-udp-family-test")
+				if err != nil {
+					t.Fatal(err)
+				}
+				service, err = shadowaead.NewService(methodName, nil, "isolated-udp-family-test", 300, handler)
+				if err != nil {
+					t.Fatal(err)
+				}
+			}
+			capture := &udpFamilyCapture{}
+			client := method.DialPacketConn(capture)
+			groups := map[int]int{}
+			for sequence, target := range []struct {
+				address string
+				group   int
+			}{
+				{"192.0.2.10:8001", 4}, {"192.0.2.11:8002", 4},
+				{"[2001:db8::10]:8001", 6}, {"[2001:db8::11]:8002", 6},
+				{"192.0.2.10:8001", 4}, {"[2001:db8::10]:8001", 6},
+				{"ipv4.example.test:8001", 40}, {"ipv6.example.test:8001", 60},
+				{"ipv4.example.test:8002", 40}, {"ipv6.example.test:8002", 60},
+			} {
+				destination := M.ParseSocksaddr(target.address)
+				payload := []byte{byte(sequence)}
+				if _, err := client.WriteTo(payload, destination); err != nil {
+					t.Fatal(err)
+				}
+				packet := buf.NewPacket()
+				packet.Write(capture.wire)
+				if err := service.NewPacket(ctx, nil, packet, M.Metadata{Source: M.ParseSocksaddr("127.0.0.1:40000")}); err != nil {
+					t.Fatal(err)
+				}
+				select {
+				case event := <-handler.events:
+					if event.destination != target.address || event.payload != string(payload) {
+						t.Fatalf("corrupted packet: %+v", event)
+					}
+					if previous, ok := groups[target.group]; ok && previous != event.connection {
+						t.Fatal("same-family destination opened another NAT session")
+					}
+					for group, connection := range groups {
+						if group != target.group && connection == event.connection {
+							t.Fatal("different-family or unknown domain reused one NAT socket")
+						}
+					}
+					groups[target.group] = event.connection
+					if groups[4] != 0 && groups[4] == groups[6] {
+						t.Fatal("IPv4 and IPv6 reused one NAT socket")
+					}
