index 0000000..73d7267
--- /dev/null
+++ b/shadowaead_2022/udp_family_reply_test.go
@@ -0,0 +1,125 @@
+package shadowaead_2022
+
+import (
+	"encoding/binary"
+	"io"
+	"net"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing/common/buf"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+type replyCapture struct {
+	mu      sync.Mutex
+	packets [][]byte
+}
+
+func (c *replyCapture) WritePacket(packet *buf.Buffer, _ M.Socksaddr) error {
+	c.mu.Lock()
+	c.packets = append(c.packets, append([]byte{}, packet.Bytes()...))
+	c.mu.Unlock()
+	packet.Release()
+	return nil
+}
+func (*replyCapture) ReadPacket(*buf.Buffer) (M.Socksaddr, error) { return M.Socksaddr{}, io.EOF }
+func (*replyCapture) Close() error                                { return nil }
+func (*replyCapture) LocalAddr() net.Addr {
+	return &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 40000}
+}
+func (*replyCapture) SetDeadline(time.Time) error      { return nil }
+func (*replyCapture) SetReadDeadline(time.Time) error  { return nil }
+func (*replyCapture) SetWriteDeadline(time.Time) error { return nil }
+
+// The two NAT sockets can now reply concurrently through one crypto session.
+// Verify the real response writer under -race and decrypt every ciphertext;
+// distinct packet IDs/nonces and all payloads must survive concurrent writes.
+func Test2022SplitSessionConcurrentReplies(t *testing.T) {
+	for _, methodName := range List {
+		t.Run(methodName, func(t *testing.T) {
+			keySize := 32
+			if methodName == "2022-blake3-aes-128-gcm" {
+				keySize = 16
+			}
+			service, err := NewService(methodName, make([]byte, keySize), 300, nil, nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			s := service.(*Service)
+			session := s.newUDPSession()
+			session.remoteSessionId = 42
+			output := &replyCapture{}
+			writers := []*serverPacketWriter{
+				{Service: s, source: output, nat: output, session: session, udpBlockCipher: s.udpBlockCipher},
+				{Service: s, source: output, nat: output, session: session, udpBlockCipher: s.udpBlockCipher},
+			}
+			var wg sync.WaitGroup
+			errors := make(chan error, 64)
+			for i := 0; i < 64; i++ {
+				wg.Add(1)
+				go func(i int) {
+					defer wg.Done()
+					packet := buf.NewSize(1024)
+					packet.Resize(512, 0)
+					packet.Write([]byte{byte(i)})
+					target := M.ParseSocksaddr("192.0.2.10:8001")
+					if i%2 != 0 {
+						target = M.ParseSocksaddr("[2001:db8::10]:8001")
+					}
+					if err := writers[i%2].WritePacket(packet, target); err != nil {
+						errors <- err
+					}
+				}(i)
+			}
+			wg.Wait()
+			close(errors)
+			for err := range errors {
+				t.Error(err)
+			}
+			if len(output.packets) != 64 {
+				t.Fatalf("got %d encrypted replies", len(output.packets))
+			}
+			counters, payloads, nonces := map[uint64]bool{}, map[byte]bool{}, map[string]bool{}
+			for _, wire := range output.packets {
+				var header, plain []byte
+				if s.udpCipher != nil {
+					nonce := wire[:PacketNonceSize]
+					if nonces[string(nonce)] {
+						t.Fatal("response nonce repeated")
+					}
+					nonces[string(nonce)] = true
+					plain, err = s.udpCipher.Open(nil, nonce, wire[PacketNonceSize:], nil)
+					if err != nil {
+						t.Fatal(err)
+					}
+					header, plain = plain[:16], plain[16:]
+				} else {
+					header = append([]byte{}, wire[:16]...)
+					s.udpBlockCipher.Decrypt(header, header)
+					plain, err = session.cipher.Open(nil, header[4:16], wire[16:], nil)
+					if err != nil {
+						t.Fatal(err)
+					}
+				}
+				if binary.BigEndian.Uint64(header[:8]) != session.sessionId {
+					t.Fatal("reply crypto session changed")
+				}
+				id := binary.BigEndian.Uint64(header[8:])
+				if counters[id] {
+					t.Fatal("response counter repeated")
+				}
+				counters[id] = true
+				if len(plain) == 0 {
+					t.Fatal("empty decrypted response")
+				}
+				payloads[plain[len(plain)-1]] = true
+			}
+			if len(payloads) != 64 {
+				t.Fatalf("corrupted response payloads: %d", len(payloads))
+			}
+		})
+	}
+}
+
